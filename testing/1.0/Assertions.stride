# Assertions.stride

module ExpectEqual {
	ports: [
		mainOutputPort OutputPort {
			block: Expected
		},
		mainInputPort InputPort {
			block: Actual
		}
	]
	blocks: [
	]
	streams: [
		Actual >> Expected;
	]
}

module ExpectNear {
	ports: [
		mainOutputPort OutputPort {
			block: Expected
		},
		mainInputPort InputPort {
			block: Actual
		},
		propertyInputPort EpsilonPort {
			name: 'epsilon'
			block: Epsilon
		}
	]
	blocks: [
		propertyBlock Epsilon {
			default: 0.0001
		}
	]
	streams: [
		Actual >> Expected;
	]
}

