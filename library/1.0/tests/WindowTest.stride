_domainDefinition FlatTopDom {
    framework: _JitFramework
    rate: -1
    substitutions: []
    domainIncludes: []
    inputs: [
        signal FlatTopIndex { domain: FlatTopDom type: Real }
        signal FlatTopSize { domain: FlatTopDom type: Real }
    ]
    outputs: [
        signal FlatTopWeight { domain: FlatTopDom type: Real }
    ]
    domainFunctionCode: ''
