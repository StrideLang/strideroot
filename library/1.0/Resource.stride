type _ResourceConfigurationType {
	typeName: "resourceConfiguration"
	properties: [
		typeProperty Name {
			name: "name"
			allowedTypes: _StringLiteral
			required: on
			meta: "Name of configuration option"
		},
		typeProperty PossibleValues {
			name: "possibleValues"
			allowedTypes: constrainedList { anyOf: [_Any] }
			default: []
			required: off
			meta: "List of possible values for the option if empty, free selection"
		},
		typeProperty Minimum {
			name: "minimum"
			allowedTypes: constrainedEntity { anyOf: [_IntLiteral, _RealLiteral, _NoneLiteral] }
			default: none
			required: off
			meta: "Minimum value allowed"
		},
		typeProperty Maximum {
			name: "maximum"
			allowedTypes: constrainedEntity { anyOf: [_IntLiteral, _RealLiteral, _NoneLiteral] }
			default: none
			required: off
			meta: "Maximum value allowed"
		},
		typeProperty Default {
			name: "default"
			allowedTypes: constrainedEntity { anyOf: [_Any, _NoneLiteral] }
			default: none
			required: off
			meta: "Default value for option"
		},
		typeProperty Type {
			name: "type"
			allowedTypes: _Any
			required: on
			meta: "Type"
		},
		typeProperty Override {
			name: "override"
			allowedTypes: constrainedList { anyOf: [_List, _Any] }
			default: []
			required: off
			meta: "Override"
		}
	]
	inherits: [_Base]
	meta: ""
}


