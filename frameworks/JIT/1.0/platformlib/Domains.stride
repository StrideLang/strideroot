resource _RootContext {
	dependsOn: []
	exclusive: none
	meta: 'Root computation and memory context'
}

domainResource _DomainFunction {
	exclusive: on # Takes over _RootContext resource
	meta: 'Main function in _RootContext'
}

_domainDefinition RootDomain {
	framework: _JitFramework
	requiresResources: [_RootContext]
	providesResources: [_DomainFunction]
	rate: -1 # -1 is 'one-shot/final' domain
    substitutions: [ ]
    domainIncludes: []
	domainFunctionCode: ''
}

# The standard domains (PlatformLoopDomain, PlatformTimerDomain,
# PlatformAudioDomain). The host calls their _process functions: a test steps
# the loop and ticks the timer as it needs.
_domainDefinition JitLoopDomain {
	framework: _JitFramework
	rate: 0
	substitutions: [ ]
	domainIncludes: []
	domainFunctionCode: ''
}

_domainDefinition JitTimerDomain {
	framework: _JitFramework
	rate: 1000
	substitutions: [ ]
	domainIncludes: []
	domainFunctionCode: ''
}

_domainDefinition JitAudioDomain {
	framework: _JitFramework
	rate: 48000
	substitutions: [ ]
	domainIncludes: []
	domainFunctionCode: ''
}

platformModule __JitSleep {
	inputs: [Real]
	outputs: []
	processing: "@__stride_jit_sleep"
	inherits: [_Signal]
}
