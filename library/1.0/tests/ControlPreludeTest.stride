# ControlPreludeTest.stride
# Unit tests for strideroot/library/1.0/ControlPrelude.stride

functionTest RisingEdgeTest {
    target: RisingEdge
    prepare: [
        [ off, on, on, off, on ] >> Input;
    ]
    validate: [
        [ Output, [ off, on, off, off, on ] ] >> ExpectEqual();
    ]
}

functionTest FallingEdgeTest {
    target: FallingEdge
    prepare: [
        [ off, on, on, off, on, off ] >> Input;
    ]
    validate: [
        [ Output, [ off, off, off, on, off, on ] ] >> ExpectEqual();
    ]
}

functionTest LatchTest {
    target: Latch
    prepare: [
        [ 10.0, 20.0, 30.0, 40.0, 50.0 ] >> Input;
        [ on,   off,  off,  on,   off  ] >> Trigger;
    ]
    validate: [
        [ Output, [ 10.0, 10.0, 10.0, 40.0, 40.0 ] ] >> ExpectEqual();
    ]
}

# Smooth takes a time constant in seconds, converted against the rate of the output

_domainDefinition SmoothDom {
    framework: _JitFramework
    rate: 100
    substitutions: []
    domainIncludes: []
    inputs: [
        signal SmoothIn { domain: SmoothDom type: Real }
    ]
    outputs: [
        signal SmoothOut { domain: SmoothDom type: Real }
    ]
    domainFunctionCode: ''
}
SmoothIn >> Smooth(time: 0.1) >> SmoothOut;

functionTest SmoothTest {
    target: SmoothDom
    prepare: [
        [ 1.000000, 1.000000, 1.000000, 1.000000, 1.000000, 1.000000 ] >> SmoothIn;
    ]
    validate: [
        [ SmoothOut, [ 0.095163, 0.181269, 0.259182, 0.329680, 0.393469, 0.451188 ] ] >> ExpectNear(epsilon: 0.0001);
    ]
}

_domainDefinition SmoothRateDom {
    framework: _JitFramework
    rate: 200
    substitutions: []
    domainIncludes: []
    inputs: [
        signal SmoothRateIn { domain: SmoothRateDom type: Real }
    ]
    outputs: [
        signal SmoothRateOut { domain: SmoothRateDom type: Real }
    ]
    domainFunctionCode: ''
}
SmoothRateIn >> Smooth(time: 0.1) >> SmoothRateOut;

functionTest SmoothTimeIsIndependentOfRateTest {
    target: SmoothRateDom
    prepare: [
        [ 1.000000, 1.000000, 1.000000, 1.000000, 1.000000, 1.000000, 1.000000, 1.000000, 1.000000, 1.000000, 1.000000, 1.000000 ] >> SmoothRateIn;
    ]
    validate: [
        [ SmoothRateOut, [ 0.048771, 0.095163, 0.139292, 0.181269, 0.221199, 0.259182, 0.295312, 0.329680, 0.362372, 0.393469, 0.423050, 0.451188 ] ] >> ExpectNear(epsilon: 0.0001);
    ]
}
