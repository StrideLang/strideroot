# Stride Core Strings Platform Modules & Wrappers

platformModule Substring {
    meta: "Extracts a zero-copy substring slice given start index and length (-1 for remainder of string)."
    inputs: [_StringType, _IntType, _IntType]
    outputs: [_StringType]
    processing: "@__stride_jit_string_substring"
    inherits: [_Signal]
}

platformModule Trim {
    meta: "Trims leading and trailing characters matching the charset from the input string."
    inputs: [_StringType, _StringType]
    outputs: [_StringType]
    processing: "@__stride_jit_string_trim"
    inherits: [_Signal]
}

platformModule TrimLeft {
    meta: "Trims leading characters matching the charset from the input string."
    inputs: [_StringType, _StringType]
    outputs: [_StringType]
    processing: "@__stride_jit_string_trim_left"
    inherits: [_Signal]
}

platformModule TrimRight {
    meta: "Trims trailing characters matching the charset from the input string."
    inputs: [_StringType, _StringType]
    outputs: [_StringType]
    processing: "@__stride_jit_string_trim_right"
    inherits: [_Signal]
}

platformModule Find {
    meta: "Finds the first occurrence of a substring starting from an offset; returns 0-based index or -1 if not found."
    inputs: [_StringType, _StringType, _IntType]
    outputs: [_IntType]
    processing: "@__stride_jit_string_find"
    inherits: [_Signal]
}

platformModule FindLast {
    meta: "Finds the last occurrence of a substring; returns 0-based index or -1 if not found."
    inputs: [_StringType, _StringType]
    outputs: [_IntType]
    processing: "@__stride_jit_string_find_last"
    inherits: [_Signal]
}

platformModule Contains {
    meta: "Checks if the string contains the specified substring; returns on/off switch."
    inputs: [_StringType, _StringType]
    outputs: [_SwitchType]
    processing: "@__stride_jit_string_contains"
    inherits: [_Signal]
}

platformModule StartsWith {
    meta: "Checks if the string starts with the specified prefix; returns on/off switch."
    inputs: [_StringType, _StringType]
    outputs: [_SwitchType]
    processing: "@__stride_jit_string_starts_with"
    inherits: [_Signal]
}

platformModule EndsWith {
    meta: "Checks if the string ends with the specified suffix; returns on/off switch."
    inputs: [_StringType, _StringType]
    outputs: [_SwitchType]
    processing: "@__stride_jit_string_ends_with"
    inherits: [_Signal]
}

platformModule Equal@String_Bool {
    meta: "Compares two strings for byte-wise equality; returns on/off switch."
    inputs: [_StringType, _StringType]
    outputs: [_SwitchType]
    processing: "@__stride_jit_string_equal"
    inherits: [_Signal]
}

platformModule Compare@String_Int {
    meta: "Performs lexicographical comparison of two strings; returns negative, 0, or positive integer."
    inputs: [_StringType, _StringType]
    outputs: [_IntType]
    processing: "@__stride_jit_string_compare"
    inherits: [_Signal]
}

platformModule Length {
    meta: "Returns the byte length of the string."
    inputs: [_StringType]
    outputs: [_IntType]
    processing: "@__stride_jit_string_length"
    inherits: [_Signal]
}

platformModule IsEmpty {
    meta: "Checks if the string is empty (length == 0); returns on/off switch."
    inputs: [_StringType]
    outputs: [_SwitchType]
    processing: "@__stride_jit_string_is_empty"
    inherits: [_Signal]
}

platformModule Parse@String_Int {
    meta: "Parses an integer from the string, returning the provided default value if parsing fails."
    inputs: [_StringType, _IntType]
    outputs: [_IntType]
    processing: "@__stride_jit_string_parse_int"
    inherits: [_Signal]
}

platformModule Parse@String_Real {
    meta: "Parses a real number from the string, returning the provided default value if parsing fails."
    inputs: [_StringType, _RealType]
    outputs: [_RealType]
    processing: "@__stride_jit_string_parse_real"
    inherits: [_Signal]
}

platformModule PrintLn {
    meta: "Prints the string followed by a newline to standard output."
    inputs: [_StringType]
    outputs: []
    processing: "@__stride_jit_string_println"
    inherits: [_Signal]
}

platformModule Print {
    meta: "Prints the string to standard output without a trailing newline."
    inputs: [_StringType]
    outputs: []
    processing: "@__stride_jit_string_print"
    inherits: [_Signal]
}

platformModule Concat {
    meta: "Concatenates two or more strings into a contiguous output string."
    inputs: [
        variadic {
            types: [_StringType]
            min: 2
        }
    ]
    outputs: [_StringType]
    processing: "@__stride_jit_string_concat_n"
    inherits: [_Signal]
}

platformModule Format {
    meta: "Formats values into a string using a template with '{}' placeholders."
    inputs: [
        _StringType,
        variadic {
            types: [_IntType, _RealType, _SwitchType, _StringType]
            min: 1
        }
    ]
    outputs: [_StringType]
    processing: "@__stride_jit_string_format"
    inherits: [_Signal]
}

platformModule Repeat {
    meta: "Repeats the input string N times into a contiguous output string."
    inputs: [_StringType, _IntType]
    outputs: [_StringType]
    processing: "@__stride_jit_string_repeat"
    inherits: [_Signal]
}

platformModule TokenAt {
    meta: "Extracts the zero-copy token slice at the specified 0-based index using the delimiter."
    inputs: [_StringType, _StringType, _IntType]
    outputs: [_StringType]
    processing: "@__stride_jit_string_token_at"
    inherits: [_Signal]
}

platformModule TokenCount {
    meta: "Returns the number of tokens in the string separated by the delimiter."
    inputs: [_StringType, _StringType]
    outputs: [_IntType]
    processing: "@__stride_jit_string_token_count"
    inherits: [_Signal]
}
