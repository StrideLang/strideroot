#
# ARM Cortex-M4 core family (ARMv7E-M, 32-bit pointers, single-precision FPU).
#
# Shared across platforms built on Cortex-M4 (such as STMicroelectronics STM32F4).
# Devices overlay this core and add their memory, clock, and peripherals.
#

package CortexM4

import Codegen

core CortexM4 {
    # Hard-float ABI: floats are passed in FPU registers. Every object linked
    # with the program (runtime, C library multilib, component archives) must
    # be built with -mfloat-abi=hard; the linker rejects a mix.
    triple: "thumbv7em-none-eabihf"
    pointerBits: 32
    types: {
        int: "Int32"
        real: "Float32"
        size: "UInt32"
    }
    hardwareFloat: on
    cacheLine: 0
    codegen: Codegen::Llvm
    meta: "ARM Cortex-M4 (ARMv7E-M), 32-bit pointers, single-precision hardware FPU"
}
