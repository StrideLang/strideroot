#
# Stride Standard DSP Package - Delay: Fractional Delay Line
#

package Dsp::Delay::FractionalDelay

# Linear interpolated fractional delay line
module Line {
    ports: [
        mainInputPort InputPort {
            name: "input"
            entity: Input
            meta: "Input audio signal stream"
        },
        propertyInputPort DelayPort {
            name: "delay"
            entity: DelayTime
            meta: "Delay time in seconds, converted to samples with the rate of the output. Limited to the buffer size (4096 samples) (default 0.002)"
        },
        mainOutputPort OutputPort {
            name: "output"
            entity: Output
            meta: "Delayed audio signal stream"
        }
    ]
    entities: [
        signal Input {
            type: OutputPort.type
            domain: OutputPort.domain
            rate: OutputPort.rate
        },
        signal DelayTime {
            type: OutputPort.type
            domain: OutputPort.domain
            default: 0.002
        },
        signal DelaySamples {
            type: OutputPort.type
            domain: OutputPort.domain
        },
        constant MaxBufferSize {
            value: 4096
        },
        table DelayTable {
            size: MaxBufferSize
            rate: MaxBufferSize
            domain: OutputPort.domain
        },
        signal WriteIndex {
            domain: OutputPort.domain
            default: 0
        },
        signal ReadPos {
            type: OutputPort.type
            domain: OutputPort.domain
        },
        signal ReadIndex {
            domain: OutputPort.domain
        },
        signal ReadIndexNext {
            domain: OutputPort.domain
        },
        signal Frac {
            type: OutputPort.type
            domain: OutputPort.domain
        },
        signal SampleA {
            type: OutputPort.type
            domain: OutputPort.domain
        },
        signal SampleB {
            type: OutputPort.type
            domain: OutputPort.domain
        },
        signal Output {
            type: OutputPort.type
            domain: OutputPort.domain
            rate: OutputPort.rate
        }
    ]
    streams: [
        # Write incoming sample to ring buffer
        Input >> DelayTable[WriteIndex];

        # Convert the delay from seconds to samples against the rate of the output
        DelayTime * OutputPort.rate >> DelaySamples;

        # Calculate fractional read position
        WriteIndex - DelaySamples >> ReadPos;
        ReadPos >> Wrap(min: 0.0 max: 4096.0) >> ReadPos;
        ReadPos >> Floor() >> ReadIndex;
        ReadPos - ReadIndex >> Frac;
        ReadIndex + 1 >> Wrap(min: 0.0 max: 4096.0) >> ReadIndexNext;

        # Read samples and linear interpolate
        DelayTable[ReadIndex] >> SampleA;
        DelayTable[ReadIndexNext] >> SampleB;
        (SampleA * (1.0 - Frac)) + (SampleB * Frac) >> Output;

        # Advance write pointer
        WriteIndex + 1 >> Wrap(min: 0 max: 4096) >> WriteIndex;
    ]
    meta: "Ring-buffer fractional delay line with linear interpolation: AudioIn >> FractionalDelay::Line(delay: 0.0025) >> DelayedOut. The delay is in seconds, converted against the rate of the output, up to 4096 samples (4096 / rate seconds)."
}
