type _MainInputPort {
	typeName: "mainInputPort"
	inherits: [_Port, _PortAttributes]
	meta: ""
}

type _MainOutputPort {
	typeName: "mainOutputPort"
	inherits: [_Port, _PortAttributes]
	meta: ""
}

type _PropertyInputPort {
	typeName: "propertyInputPort"
	properties: [
		typeProperty Default {
			name: "default"
			allowedTypes: constrainedEntity { allowed: [_Any, _NoneLiteral] }
			default: none
			required: off
		}
	]
	inherits: [_Port, _PortAttributes]
	meta: ""
}

type _PropertyOutputPort {
	typeName: "propertyOutputPort"
	properties: [
		typeProperty Default {
			name: "default"
			allowedTypes: constrainedEntity { allowed: [_Any, _NoneLiteral] }
			default: none
			required: off
		}
	]
	inherits: [_Port, _PortAttributes]
	meta: ""
}

type _PortAttributes {
	typeName: "_portAttributes"
	properties: [
		typeProperty Rate {
			name: "rate"
			allowedTypes: constrainedEntity { allowed: [_RealLiteral, _IntLiteral, _NoneLiteral] }
			default: 0
			writeable: off
			required: off
		},
		typeProperty Domain {
			name: "domain"
			allowedTypes: constrainedEntity { allowed: [_StringLiteral, _DomainDefinition, _NoneLiteral] } # This should be made to accept type handles
			default: none
			writeable: off
			required: off
		},
		typeProperty Type {
			name: "type"
			allowedTypes: constrainedEntity { allowed: [_StringLiteral, _FrameworkDataType, _NoneLiteral] } # This should be made to accept type handles
			default: none
			writeable: off
			required: off
		},
		typeProperty Size {
			name: "size"
			allowedTypes: constrainedEntity { allowed: [_IntLiteral, _NoneLiteral] } # This should be made to accept type handles
			default: none
			writeable: off
			required: off
		}
	]
	inherits: []
	meta: "Port attributes should be set by the resolver, and only readable externally"
}

type _Port {
	typeName: "port"
	properties: [
		typeProperty Name {
			name: "name"
			allowedTypes: _StringLiteral
			default: ""
			required: off
		},
		typeProperty Block {
			name: "block"
			allowedTypes: _Block
			required: on
		},
		typeProperty Type {
			name: "allowedTypes"
			allowedTypes: constrainedEntity { allowed: [_StringLiteral, _FrameworkDataType, _NoneLiteral] } # This should be made to accept type handles
			default: none # None means undefined. Should be resolved from context, and if not possible should resolve to _DefaultSignalType
			required: off
		},
		typeProperty Size {
			name: "size"
			allowedTypes: constrainedEntity { allowed: [_IntLiteral, _NoneLiteral] } 
			default: 0 
			required: off
			public: on
			meta: "Size of connected outer block"
		},
		typeProperty Rate {
			name: "rate"
			allowedTypes: constrainedEntity { allowed: [_RealLiteral, _IntLiteral, _NoneLiteral] }
			default: 0
			required: off
			public: on
			meta: "Rate of connected outer block"
		}
	]
	inherits: [_Base]
	meta: ""
}


type _Callable {
	typeName: "callable"
	properties: [
		typeProperty Ports {
			name: "ports"
			allowedTypes: constrainedList { allowed: [_MainOutputPort, _MainInputPort, _PropertyOutputPort, _PropertyInputPort] } 
			default: []
			required: off
		}
	]
	meta: "Objects can be used as functions within streams"
}
