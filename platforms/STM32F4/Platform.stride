#
# STMicroelectronics STM32F4 Platform Definition
#

import QualityPolicy
import STM32F4xx
import STM32F407VG

platform STM32F4 {
    framework: "STM32"
    defaultDevice: STM32F407VG
    supportedDevices: [
        STM32F407VG
    ]

    # Baseline platform policies for all STM32F4 devices (hardware FPU)
    platformPolicies: [
        policyBinding [] {
            policy: QualityPolicy::Optimal
            function: [ Sin,        Cos,        Tan        ]
            target:   [ Sin@Direct, Cos@Direct, Tan@Direct ]
        },
        policyBinding [] {
            policy: QualityPolicy::Fast
            function: [ Sin,       Cos       ]
            target:   [ Sin@Poly5, Cos@Poly5 ]
        },
        policyBinding [] {
            policy: QualityPolicy::Accurate
            function: [ Sin,        Cos        ]
            target:   [ Sin@Direct, Cos@Direct ]
        },
        policyBinding [] {
            policy: QualityPolicy::Compact
            function: [ Sin,        Cos        ]
            target:   [ Sin@Direct, Cos@Direct ]
        }
    ]
    meta: "STMicroelectronics STM32F4 ARM Cortex-M4 family platform support"
}
