#
# STMicroelectronics STM32F746NG Base Device Configuration
#

import Gpio
import CortexM7
import STM32F7Resources

device STM32F746NG {
    platform: STM32F7
    overlays: CortexM7
    cpu: "cortex-m7"
    compilerFlags: "-march=armv7e-m -mcpu=cortex-m7 -mfpu=fpv5-sp-d16 -mfloat-abi=hard"
    clock: 216000000
    memory: {
        flash: 1048576
        ram: 327680
    }
    ports: [
        gpioPort GPIOA {
            width: 32
            input: 0x40020010
            output: 0x40020014
            outputSet: 0x40020018
            outputClear: 0x40020018
            setShift: 0
            clearShift: 16
            enable: { register: 0x40023830 bit: 0 }
            fields: [
                gpioField Mode {
                    option: Gpio::_PinModes
                    register: 0x40020000
                    bitsPerPin: 2
                    options: [Gpio::PinInput, Gpio::PinOutput, Gpio::PinAnalog]
                    codes: [0, 1, 3]
                },
                gpioField OutputType {
                    option: Gpio::_PinOutputTypes
                    register: 0x40020004
                    bitsPerPin: 1
                    options: [Gpio::OutputPushPull, Gpio::OutputOpenDrain]
                    codes: [0, 1]
                },
                gpioField Pull {
                    option: Gpio::_PinPulls
                    register: 0x4002000C
                    bitsPerPin: 2
                    options: [Gpio::PullNone, Gpio::PullUp, Gpio::PullDown]
                    codes: [0, 1, 2]
                }
            ]
        },
