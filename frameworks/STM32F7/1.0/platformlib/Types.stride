
frameworkDataType _RealType {
	frameworkName: "float"
	includes: []
}

frameworkDataType _IntType {
	frameworkName: "int"
	includes: []
}

frameworkDataType _UnsingedIntType {
	frameworkName: "uint64_t"
	includes: ["<cstdint>"]
}

frameworkDataType _SizeType {
	frameworkName: "size_t"
	includes: []
}

frameworkDataType _SwitchType {
	frameworkName: "bool"
	includes: []
}

# FIXME fix strings
frameworkDataType _StringType {
	frameworkName: "char *"
	includes: []
}

### ----------------------
# Type classes: the first member of 'types' is the default data type.

typeClass _NumericTypes {
	types: [_RealType, _IntType, _UnsingedIntType, _SizeType]
}
