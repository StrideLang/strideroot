# Math from newlib libm (float variants for Float32 Real).

platformModule __Abs {
    inputs: [Real]
    outputs: [Real]
    resources: [_STM32MathLib]
    linkTo: ["m"]
    processing: "@fabsf"
    inherits: [_Signal]
}

platformModule __Floor {
    inputs: [Real]
    outputs: [Real]
    resources: [_STM32MathLib]
    linkTo: ["m"]
    processing: "@floorf"
    inherits: [_Signal]
}

# e raised to the input
platformModule __Exp {
    inputs: [Real]
    outputs: [Real]
    resources: [_STM32MathLib]
    linkTo: ["m"]
    processing: "@expf"
    inherits: [_Signal]
}

# First input raised to the second input
platformModule __Pow {
    inputs: [Real, Real]
    outputs: [Real]
    resources: [_STM32MathLib]
    linkTo: ["m"]
    processing: "@powf"
    inherits: [_Signal]
}

platformModule __Sin {
    inputs: [Real]
    outputs: [Real]
    resources: [_STM32MathLib]
    linkTo: ["m"]
    processing: "@sinf"
    inherits: [_Signal]
}

platformModule __Cos {
    inputs: [Real]
    outputs: [Real]
    resources: [_STM32MathLib]
    linkTo: ["m"]
    processing: "@cosf"
    inherits: [_Signal]
}

platformModule __Tan {
    inputs: [Real]
    outputs: [Real]
    resources: [_STM32MathLib]
    linkTo: ["m"]
    processing: "@tanf"
    inherits: [_Signal]
}
