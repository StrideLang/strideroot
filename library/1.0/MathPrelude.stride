			domain: OutputPort.domain
		},
		signal Output {
			rate: OutputPort.rate
			type: OutputPort.type
			domain: OutputPort.domain
		}
	]
	streams: [
		[Input[0], Input[1]] >> __Pow() >> Output;
	]
	meta: "Computes Base raised to the power of Exponent: pow(Input[0], Input[1])."
