#
# Stride Standard Library - Math Package Constants
#

package Math

constant Pi {
    value: 3.14159265358979323846264338327950288419716939937510
    meta: "Mathematical constant Pi (ratio of a circle's circumference to its diameter)"
}

constant TwoPi {
    value: 6.28318530717958647692528676655900576839433879875021
    meta: "Mathematical constant 2 * Pi (tau)"
}

constant E {
    value: 2.71828182845904523536028747135266249775724709369995
    meta: "Euler's number (base of natural logarithm)"
}
