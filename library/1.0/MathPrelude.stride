module Sin@Direct {
	ports: [
		mainInputPort InputPort { entity: Input meta: "Input angle in radians" },
		mainOutputPort OutputPort { entity: Output meta: "Sine of the input angle" }
	]
	entities: [
		signal Input  { rate: OutputPort.rate type: OutputPort.type domain: OutputPort.domain }
		signal Output { rate: OutputPort.rate type: OutputPort.type domain: OutputPort.domain }
	]
	streams: [
		Input >> __SinDirect() >> Output;
	]
	meta: "Direct IEEE standard library sine function."
}

module Sin@Poly5 {
	ports: [
		mainInputPort InputPort { entity: Input meta: "Input angle in radians [-pi, pi]" },
		mainOutputPort OutputPort { entity: Output meta: "5th-order minimax polynomial sine" }
	]
	entities: [
		signal Input  { rate: OutputPort.rate type: OutputPort.type domain: OutputPort.domain }
		signal Output { rate: OutputPort.rate type: OutputPort.type domain: OutputPort.domain }
		signal X2     { rate: OutputPort.rate type: OutputPort.type domain: OutputPort.domain }
		constant C1   { value: -0.1666483932 }
		constant C2   { value:  0.0083178591 }
		constant C3   { value: -0.0001939485 }
		constant C4   { value:  0.0000022109 }
	]
	streams: [
		Input * Input >> X2;
		Input * (1.0 + X2 * (C1 + X2 * (C2 + X2 * (C3 + C4 * X2)))) >> Output;
	]
	meta: "Universal pure Stride 5th-order minimax polynomial sine approximation."
}

