type _CodeGenerator {
	typeName: "codeGenerator"
	properties: [
		typeProperty {
			name: "blocks"
			types: [ constrainedList {anyOf: [_Streamable, _Reaction, _Module]} ]
			default: []
			required: off
		},
		typeProperty Streams {
			name: "streams"
			types: [ constrainedList {anyOf: [_StreamType]} ]
			default: none
			required: on
		}
	]
}

type _Module {
	typeName: "module"
	properties: [
		typeProperty Contraints {
			name: "constraints"
			types: [""]
			default: none
			required: off
		}
	]
	inherits: [_Base, _CodeGenerator, _Callable]
	meta: "Modules encapsulate streams"
}

type _Reaction {
	typeName: "reaction"
	properties: [
		typeProperty Contraints {
			name: "constraints"
			types: [""]
			default: none
			required: off
		}
	]
	inherits: [_Base, _DomainMember, _CodeGenerator, _Callable]
}

type _Loop {
	typeName: "loop"
	properties: [
		typeProperty OnExecution {
			name: "onExecution"
			types: [""]
			default: none
			required: off
		},
		typeProperty OnTermination {
			name: "onTermination"
			types: [""]
			default: none
			required: off
		},
		typeProperty TerminateWhen {
			name: "terminateWhen"
			types: [""]
			default: none
			required: off
		},
		typeProperty Contraints {
			name: "constraints"
			types: [""]
			default: none
			required: off
		}
	]
	inherits: [_Base, _DomainMember, _CodeGenerator, _Callable]
}
