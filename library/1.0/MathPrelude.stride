module Abs {
	ports: [
		mainInputPort InputPort {
			entity: Input
			meta: "Input value"
		},
		mainOutputPort OutputPort {
			entity: Output
			meta: "Absolute value" 
		}
	]
	entities: [
		signal Input  {
            rate: OutputPort.rate
            type: OutputPort.type
            domain: OutputPort.domain
        }
		signal Output {
            rate: OutputPort.rate
            type: OutputPort.type
            domain: OutputPort.domain
        }
	]
	streams: [
		Input >> __Abs() >> Output;
	]
	meta: "Returns the absolute value of the input signal."
}

module Sign {
	ports: [
		mainInputPort InputPort {
			entity: Input
			meta: "Input value"
		},
		mainOutputPort OutputPort {
			entity: Output
			meta: "Sign of the input (-1.0, 0.0, or 1.0)"
		}
	]
	entities: [
		signal Input  {
            rate: OutputPort.rate
            type: OutputPort.type
            domain: OutputPort.domain
        }
		signal Output {
            rate: OutputPort.rate
            type: OutputPort.type
            domain: OutputPort.domain
        }
		switch IsPos  {
            rate: OutputPort.rate
            domain: OutputPort.domain
        }
		switch IsNeg  {
            rate: OutputPort.rate
            domain: OutputPort.domain
        }
		signal PosVal {
            rate: OutputPort.rate
            type: OutputPort.type
            domain: OutputPort.domain
        }
	]
	streams: [
		[Input, 0.0] >> Greater() >> IsPos;
		[Input, 0.0] >> Less()    >> IsNeg;
		[IsPos, 1.0, 0.0] >> __Select() >> PosVal;
		[IsNeg, -1.0, PosVal] >> __Select() >> Output;
	]
	meta: "Returns 1.0 if input > 0, -1.0 if input < 0, and 0.0 if input == 0."
}

module Cos {
	ports: [
		mainInputPort InputPort {
			entity: Input
			meta: "Input angle in radians"
		},
		mainOutputPort OutputPort {
			entity: Output
			meta: "Cosine of the input angle" 
		}
	]
	entities: [
		signal Input  {
            rate: OutputPort.rate
            type: OutputPort.type
            domain: OutputPort.domain
        }
		signal Output {
            rate: OutputPort.rate
            type: OutputPort.type
            domain: OutputPort.domain
        }
	]
	streams: [
		Input >> __Cos() >> Output;
	]
	meta: "Cosine function of angle in radians."
}

module Cos@Direct {
	ports: [
		mainInputPort InputPort { entity: Input meta: "Input angle in radians" },
		mainOutputPort OutputPort { entity: Output meta: "Cosine of the input angle" }
	]
	entities: [
		signal Input  { rate: OutputPort.rate type: OutputPort.type domain: OutputPort.domain }
		signal Output { rate: OutputPort.rate type: OutputPort.type domain: OutputPort.domain }
	]
	streams: [
		Input >> __CosDirect() >> Output;
	]
	meta: "Direct IEEE standard library cosine function."
}

module Cos@Poly5 {
	ports: [
		mainInputPort InputPort { entity: Input meta: "Input angle in radians [-pi, pi]" },
		mainOutputPort OutputPort { entity: Output meta: "5th-order minimax polynomial cosine" }
	]
	entities: [
		signal Input  { rate: OutputPort.rate type: OutputPort.type domain: OutputPort.domain }
		signal Output { rate: OutputPort.rate type: OutputPort.type domain: OutputPort.domain }
		signal X2     { rate: OutputPort.rate type: OutputPort.type domain: OutputPort.domain }
		constant C1   { value: -0.4999999963 }
		constant C2   { value:  0.0416666418 }
		constant C3   { value: -0.0013888397 }
	]
	streams: [
		Input * Input >> X2;
		1.0 + X2 * (C1 + X2 * (C2 + C3 * X2)) >> Output;
	]
	meta: "Universal pure Stride minimax polynomial cosine approximation."
}


module Sin {
	ports: [
		mainInputPort InputPort {
			entity: Input
			meta: "Input angle in radians"
		},
		mainOutputPort OutputPort {
