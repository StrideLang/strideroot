#
# Stride Standard Library - Estimation Package: Real-Time Peak Detector
#

package Estimation::PeakDetector

# Real-time local maximum detector with amplitude threshold
module Detector {
    ports: [
        mainInputPort InputPort {
            name: "input"
            entity: Input
            meta: "Input signal stream to monitor for peaks"
        },
        propertyInputPort ThresholdPort {
            name: "threshold"
            entity: Threshold
            meta: "Minimum peak amplitude threshold (default 0.5)"
        },
        mainOutputPort OutputPort {
            name: "output"
            entity: Output
            meta: "Switch that is on for one tick when a peak was detected. The detection is made one tick late, as a peak can only be confirmed by the sample that follows it"
        }
    ]
    entities: [
        signal Input {
            type: InputPort.type
            domain: OutputPort.domain
            rate: OutputPort.rate
        },
        signal Threshold {
            type: InputPort.type
            domain: OutputPort.domain
            default: 0.5
        },
        signal X0 {
            type: InputPort.type
            domain: OutputPort.domain
            default: 0.0
        },
        signal X1 {
            type: InputPort.type
            domain: OutputPort.domain
            default: 0.0
        },
        signal X2 {
            type: InputPort.type
            domain: OutputPort.domain
            default: 0.0
        },
        switch Rising {
            domain: OutputPort.domain
        },
        switch Falling {
            domain: OutputPort.domain
        },
        switch PeakShape {
            domain: OutputPort.domain
        },
        switch AboveThreshold {
            domain: OutputPort.domain
        },
        switch IsPeak {
            domain: OutputPort.domain
        },
        switch Output {
            domain: OutputPort.domain
            rate: OutputPort.rate
        }
    ]
    streams: [
        Input >> X0;

        # Peak detection: X1 is greater than X2 (rising) and greater than X0 (falling)
        [X1, X2] >> Greater() >> Rising;
        [X1, X0] >> Greater() >> Falling;
        [Rising, Falling] >> And() >> PeakShape;

        # Amplitude condition
        [X1, Threshold] >> GreaterOrEqual() >> AboveThreshold;
        [PeakShape, AboveThreshold] >> And() >> IsPeak;
        IsPeak >> Output;

        # Shift sample history
        X1 >> X2;
        X0 >> X1;
    ]
    meta: "Real-time local maximum detector with a switch output: Input >> PeakDetector::Detector(threshold: 0.5) >> Peak."
}
