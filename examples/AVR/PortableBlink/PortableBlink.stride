#
# PortableBlink: blinks the board's LED from the main loop and follows a
# button from a 1 kHz timer.
#
# Nothing here names a pin, a register or an AVR domain: the pins come from
# BlinkRig.stride, and PlatformLoopDomain and PlatformTimerDomain are the
# standard domains every LLVM framework provides.
#
#   stride build PortableBlink.stride
#   stride flash PortableBlink.stride --port=COM3
#

use AVR version 1.0 on BlinkRig

import DigitalIO
import BlinkRig

# The main loop blinks Status twice a second. Sleep suspends only the loop:
# the timer keeps running while it sleeps.
switch Blink { default: off domain: PlatformLoopDomain }

Blink >> Not() >> Blink;
Blink >> DigitalIO::Led(pin: BlinkRig::Status);
0.25 >> Sleep(domain: PlatformLoopDomain);

# The timer polls the button 1000 times a second and drives the relay while
# it is pressed.
switch Pressed { default: off domain: PlatformTimerDomain }

BlinkRig::Button >> DigitalIO::DigitalIn() >> Pressed;
Pressed >> DigitalIO::DigitalOut(pin: BlinkRig::Relay);
