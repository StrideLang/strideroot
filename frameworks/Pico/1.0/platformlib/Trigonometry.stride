
# Sine function test
platformModule __Sin {
    inputs: ["real"]
	outputs: ["real"]
    include: ["cmath"]
    processing: "std::sin(%%intokens:0%%)"
    inherits: [_Signal]
}

platformModule __Cos {
    inputs: ["real"]
	outputs: ["real"]
    include: ["cmath"]
    processing: "std::cos(%%intokens:0%%)"
    inherits: [_Signal]
}

platformModule __Tan {
    inputs: ["real"]
	outputs: ["real"]
    include: ["cmath"]
    processing: "std::tan(%%intokens:0%%)"
    inherits: [_Signal]
}

# Pico Bootrom ROM-accelerated single-precision floating point
platformModule __SinPicoRom {
    inputs: ["real"]
    outputs: ["real"]
    include: ["pico/float.h"]
    processing: "float_sin(%%intokens:0%%)"
    inherits: [_Signal]
}

platformModule __CosPicoRom {
    inputs: ["real"]
    outputs: ["real"]
    include: ["pico/float.h"]
    processing: "float_cos(%%intokens:0%%)"
    inherits: [_Signal]
}

platformModule __TanPicoRom {
    inputs: ["real"]
    outputs: ["real"]
    include: ["pico/float.h"]
    processing: "float_tan(%%intokens:0%%)"
    inherits: [_Signal]
}

# Direct standard library calls (hardware FPU on RP2350 or cmath emulation)
platformModule __SinDirect {
    inputs: ["real"]
    outputs: ["real"]
    include: ["cmath"]
    processing: "std::sin(%%intokens:0%%)"
    inherits: [_Signal]
}

platformModule __CosDirect {
    inputs: ["real"]
    outputs: ["real"]
    include: ["cmath"]
    processing: "std::cos(%%intokens:0%%)"
    inherits: [_Signal]
}

platformModule __TanDirect {
    inputs: ["real"]
    outputs: ["real"]
    include: ["cmath"]
    processing: "std::tan(%%intokens:0%%)"
    inherits: [_Signal]
}

module Sin@PicoRom {
	ports: [
		mainInputPort InputPort { block: Input meta: "Input angle in radians" },
		mainOutputPort OutputPort { block: Output meta: "Pico Bootrom sine" }
	]
	blocks: [
		signal Input  { rate: OutputPort.rate type: OutputPort.type domain: OutputPort.domain }
		signal Output { rate: OutputPort.rate type: OutputPort.type domain: OutputPort.domain }
	]
	streams: [
		Input >> __SinPicoRom() >> Output;
	]
	meta: "Raspberry Pi Pico Bootrom ROM accelerated sine function."
}

module Cos@PicoRom {
	ports: [
		mainInputPort InputPort { block: Input meta: "Input angle in radians" },
		mainOutputPort OutputPort { block: Output meta: "Pico Bootrom cosine" }
	]
	blocks: [
		signal Input  { rate: OutputPort.rate type: OutputPort.type domain: OutputPort.domain }
		signal Output { rate: OutputPort.rate type: OutputPort.type domain: OutputPort.domain }
	]
	streams: [
		Input >> __CosPicoRom() >> Output;
	]
	meta: "Raspberry Pi Pico Bootrom ROM accelerated cosine function."
}

module Tan@PicoRom {
	ports: [
		mainInputPort InputPort { block: Input meta: "Input angle in radians" },
		mainOutputPort OutputPort { block: Output meta: "Pico Bootrom tangent" }
	]
	blocks: [
		signal Input  { rate: OutputPort.rate type: OutputPort.type domain: OutputPort.domain }
		signal Output { rate: OutputPort.rate type: OutputPort.type domain: OutputPort.domain }
	]
	streams: [
		Input >> __TanPicoRom() >> Output;
