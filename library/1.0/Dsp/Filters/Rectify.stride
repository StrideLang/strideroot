#
# Stride Standard DSP Package - Filters
#

package Dsp::Filters

module Rectify {
	ports: [
		mainInputPort InputPort {
			name: "input"
			entity: Input
			meta: "Input signal"
		},
		mainOutputPort OutputPort {
			name: "output"
			entity: Output
			meta: "Rectified output signal"
		}
	]
	entities: [
		signal Input { type: OutputPort.type domain: InputPort.domain },
		signal Output { type: OutputPort.type domain: OutputPort.domain }
	]
	streams: [
		Input >> Abs() >> Output;
	]
	meta: "Full-wave signal rectifier."
}
