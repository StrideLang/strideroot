# Assertions.stride

module ExpectEqual {
	ports: [
		mainInputPort InputPort {
			name: 'input'
			block: Input
		}
	]
	blocks: [
		signal Input[2] {}
	]
	streams: [
	]
}

module ExpectNear {
	ports: [
		mainInputPort InputPort {
			name: 'input'
			block: Input
		},
		propertyInputPort EpsilonPort {
			name: 'epsilon'
			block: Epsilon
		}
	]
	blocks: [
		signal Input[2] {}
		propertyBlock Epsilon {
			default: 0.0001
		}
	]
	streams: [
	]
}

