#
# STMicroelectronics STM32F767ZI (LQFP144): an STM32F7xx with 2 MB of flash and 512 KB of SRAM
# at 0x20000000 (DTCM, SRAM1 and SRAM2 in one block),
# and a double precision FPU.
#

import STM32F7xx

device STM32F767ZI {
    platform: STM32F7
    overlays: STM32F7xx
    fpu: "fpv5-d16"
    memory: {
        flash: 2097152
        ram: 524288
    }
    resources: [CortexM7HardwareFpuDp]
    upload: {
        probeRs: {
            chip: "STM32F767ZITx"
        }
    }
    meta: "STM32F767ZI ARM Cortex-M7 @ 216 MHz, 2 MB flash, 512 KB SRAM, double-precision FPU"
}
