use Wiring version 1.0

import Dsp::Generators as Generators
import IO::Serial as Serial

signal DownSample {
	rate: 0.5
	domain: WiringDomain
}

AnalogIn[0] * 4 >> DownSample >> SerialOut[0];
0.5 + (AnalogIn[0] / 128.0) >> Frequency;

[Generators::Oscillator (frequency: Frequency), 0] >> Greater() >> DigitalOut[13];
