# ControlPrelude.stride (global prelude; not to be confused with package Control in Control/)
# Signal-flow control, edge detection, and sample-and-hold operations for Stride

module OnChange {
    ports: [
        mainInputPort InputPort {
            entity: Input
            meta: "Signal or switch being monitored for changes"
        },
        mainOutputPort OutputPort {
            entity: Output
            meta: "Switch that is on when Input changed from its previous tick value"
        }
    ]
    entities: [
        signal Input {
            rate: OutputPort.rate
            type: InputPort.type
            domain: OutputPort.domain
        }
        switch Output {
            rate: OutputPort.rate
            domain: OutputPort.domain
        }
        signal Prev{
            rate: OutputPort.rate
            type: InputPort.type
            domain: OutputPort.domain
        }
    ]
    streams: [
        [Input, Prev] >> NotEqual() >> Output;
        Input >> Prev;
    ]
    meta: "Detects changes in a signal: outputs on when Input differs from previous tick: Input >> OnChange() >> Trigger."
}

module RisingEdge {
    ports: [
        mainInputPort InputPort {
            entity: Input
            meta: "Monitored switch signal"
        },
        mainOutputPort OutputPort {
            entity: Output
            meta: "Switch that is on for one tick when Input transitions from off to on"
        }
    ]
    entities: [
        switch Input   {
            rate: OutputPort.rate
            domain: OutputPort.domain
        }
        switch Output  {
            rate: OutputPort.rate
            domain: OutputPort.domain
        }
        switch Prev    {
            rate: OutputPort.rate
            domain: OutputPort.domain
            default: off
        }
        switch NotPrev {
            rate: OutputPort.rate
            domain: OutputPort.domain
        }
    ]
    streams: [
        Prev >> Not() >> NotPrev;
        [Input, NotPrev] >> And() >> Output;
        Input >> Prev;
    ]
    meta: "Detects rising edge (off -> on): Input >> RisingEdge() >> Trigger."
}

module FallingEdge {
    ports: [
        mainInputPort InputPort {
            entity: Input
            meta: "Monitored switch signal"
        },
        mainOutputPort OutputPort {
            entity: Output
            meta: "Switch that is on for one tick when Input transitions from on to off"
        }
    ]
    entities: [
        switch Input  {
            rate: OutputPort.rate
            domain: OutputPort.domain
        }
        switch Output {
            rate: OutputPort.rate
            domain: OutputPort.domain
        }
        switch Prev   {
            rate: OutputPort.rate
            domain: OutputPort.domain
            default: off
        }
        switch NotIn  {
            rate: OutputPort.rate
            domain: OutputPort.domain
        }
    ]
    streams: [
        Input >> Not() >> NotIn;
        [NotIn, Prev] >> And() >> Output;
        Input >> Prev;
    ]
    meta: "Detects falling edge (on -> off): Input >> FallingEdge() >> Trigger."
}

module Latch {
    ports: [
        mainInputPort InputPort {
            entity: Input
            meta: "Continuous signal to be sampled and held"
        },
        mainOutputPort OutputPort {
            entity: Output
            meta: "Sampled and held output signal"
        },
        propertyInputPort TriggerProperty {
            name: "trigger"
            entity: Trigger
            meta: "Sample trigger: when on, samples Input; when off, holds previous value"
        }
    ]
    entities: [
        signal Input   {
            rate: OutputPort.rate
            type: OutputPort.type
            domain: OutputPort.domain
        }
        signal Output  {
            rate: OutputPort.rate
            type: OutputPort.type
            domain: OutputPort.domain
        }
        switch Trigger {
            rate: OutputPort.rate
            domain: OutputPort.domain
            default: off
        }
        signal Held    {
            rate: OutputPort.rate
            type: OutputPort.type
            domain: OutputPort.domain
            default: 0.0
        }
    ]
    streams: [
        [Trigger, Input, Held] >> __Select() >> Held;
        Held >> Output;
    ]
    meta: "Sample and hold: samples Input when trigger is on and holds the value when off: Input >> Latch(trigger: Gate) >> Output."
}

module Smooth {
    ports: [
        mainInputPort InputPort {
            entity: Input
            meta: "Signal to be smoothed"
        },
        mainOutputPort OutputPort {
            entity: Output
            meta: "Smoothed output signal"
        },
        propertyInputPort TimeProperty {
            name: "time"
            entity: Time
            meta: "Time constant in seconds: the time the output takes to cover 63% of a step in the input. 0 disables smoothing."
        }
    ]
    entities: [
        signal Input {
            rate: OutputPort.rate
            type: OutputPort.type
            domain: OutputPort.domain
        }
        signal Output {
            rate: OutputPort.rate
            type: OutputPort.type
            domain: OutputPort.domain
        }
        signal Time {
            type: OutputPort.type
            domain: OutputPort.domain
            default: 0.01
        }
        signal SafeTime {
            type: OutputPort.type
            domain: OutputPort.domain
        }
        signal Exponent {
            type: OutputPort.type
            domain: OutputPort.domain
        }
        signal Coeff {
            type: OutputPort.type
            domain: OutputPort.domain
        }
        signal Prev {
            rate: OutputPort.rate
            type: OutputPort.type
            domain: OutputPort.domain
            default: 0.0
        }
    ]
    streams: [
        # The one-pole coefficient is derived from the time constant and the rate
        # of the output, so the smoothing time is the same at any sample rate:
        #   coefficient = exp(-1 / (time * rate))
        [Time, 0.000001] >> Max() >> SafeTime;
        -1.0 / (SafeTime * OutputPort.rate) >> Exponent;
        Exponent >> Exp() >> Coeff;
        (Input * (1.0 - Coeff)) + (Prev * Coeff) >> Output;
        Output >> Prev;
    ]
    meta: "Exponential (one-pole low-pass) smoothing of Input with a time constant in seconds: Input >> Smooth(time: 0.05) >> Output. The time is converted with the rate of the output, so it is independent of the sample rate. Type must be a floating point type."
}
