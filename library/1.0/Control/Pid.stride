#
# Stride Standard Library - Control Package: PID Controller
#

package Control

module Pid {
    ports: [
        mainInputPort ErrorPort {
            name: "input"
            entity: Error
            meta: "Error signal (Setpoint - ProcessVariable)"
        },
        propertyInputPort KpPort {
            name: "kp"
            entity: Kp
            meta: "Proportional gain, in output units per error unit (default 1.0)"
        },
        propertyInputPort KiPort {
            name: "ki"
            entity: Ki
            meta: "Integral gain, in output units per error unit per second (default 0.0)"
        },
        propertyInputPort KdPort {
            name: "kd"
            entity: Kd
            meta: "Derivative gain, in output units per error unit per second of change, i.e. kd is a time in seconds (default 0.0)"
        },
        propertyInputPort MinPort {
            name: "min"
            entity: MinLimit
            meta: "Minimum saturation limit for integrator and output (default -1.0)"
        },
        propertyInputPort MaxPort {
            name: "max"
            entity: MaxLimit
            meta: "Maximum saturation limit for integrator and output (default 1.0)"
        },
        mainOutputPort OutputPort {
            name: "output"
            entity: Output
            meta: "Control variable output signal"
        }
    ]
    entities: [
        signal Error {
            type: OutputPort.type
            domain: OutputPort.domain
            rate: OutputPort.rate
        },
        signal Kp {
            type: OutputPort.type
            domain: OutputPort.domain
            default: 1.0
        },
        signal Ki {
            type: OutputPort.type
            domain: OutputPort.domain
            default: 0.0
        },
        signal Kd {
            type: OutputPort.type
            domain: OutputPort.domain
            default: 0.0
        },
        signal MinLimit {
            type: OutputPort.type
            domain: OutputPort.domain
            default: -1.0
        },
        signal MaxLimit {
            type: OutputPort.type
            domain: OutputPort.domain
            default: 1.0
        },
        signal PTerm {
            type: OutputPort.type
            domain: OutputPort.domain
        },
        signal ITerm {
            type: OutputPort.type
            domain: OutputPort.domain
            default: 0.0
        },
        signal ITermCandidate {
            type: OutputPort.type
            domain: OutputPort.domain
        },
        signal ITermClamped {
            type: OutputPort.type
            domain: OutputPort.domain
        },
        signal PrevError {
            type: OutputPort.type
            domain: OutputPort.domain
            default: 0.0
        },
        signal DTerm {
            type: OutputPort.type
            domain: OutputPort.domain
        },
        signal TotalOutput {
            type: OutputPort.type
            domain: OutputPort.domain
        },
        signal Output {
            type: OutputPort.type
            domain: OutputPort.domain
            rate: OutputPort.rate
        }
    ]
    streams: [
        # Proportional term
        Error * Kp >> PTerm;

        # Integral term with anti-windup clamping. The integral accumulates
        # error * ki * dt, where dt = 1 / rate of the output.
        ITerm + ((Error * Ki) / OutputPort.rate) >> ITermCandidate;
        ITermCandidate >> Clamp(min: MinLimit max: MaxLimit) >> ITermClamped;
        ITermClamped >> ITerm;

        # Derivative term: (error - previous error) / dt * kd
        ((Error - PrevError) * Kd) * OutputPort.rate >> DTerm;
        Error >> PrevError;

        # Summation and output saturation clamping
        PTerm + ITermClamped + DTerm >> TotalOutput;
        TotalOutput >> Clamp(min: MinLimit max: MaxLimit) >> Output;
    ]
    meta: "Proportional-Integral-Derivative controller with anti-windup clamping: Error >> Pid(kp: 1.0 ki: 0.05 kd: 0.1) >> Output. ki (per second) and kd (seconds) are converted against the rate of the output, so tuning does not change with the sample rate. Type must be floating point."
}
