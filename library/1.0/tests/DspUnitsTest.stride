# DspUnitsTest.stride
# Unit tests for strideroot/library/1.0/Dsp/Units.stride

import Dsp::Units as Units
import Testing as Testing

_domainDefinition MidiToFreqDom {
    framework: _JitFramework
    rate: -1
    substitutions: []
    domainIncludes: []
    inputs: [
        signal MidiToFreqNote { domain: MidiToFreqDom type: Real }
    ]
    outputs: [
        signal MidiToFreqFrequency { domain: MidiToFreqDom type: Real }
    ]
    domainFunctionCode: ''
}
MidiToFreqNote >> Units::MidiToFreq() >> MidiToFreqFrequency;

functionTest MidiToFreqTest {
    target: MidiToFreqDom
    prepare: [
        [ 69.0, 60.0, 81.0, 57.0 ] >> MidiToFreqNote;
    ]
    validate: [
        # A4, middle C, A5, A3
        [ MidiToFreqFrequency, [ 440.0, 261.6256, 880.0, 220.0 ] ] >> Testing::ExpectNear(epsilon: 0.001);
    ]
}

_domainDefinition DbToLinearDom {
    framework: _JitFramework
    rate: -1
    substitutions: []
    domainIncludes: []
    inputs: [
        signal DbToLinearDb { domain: DbToLinearDom type: Real }
    ]
    outputs: [
        signal DbToLinearLinear { domain: DbToLinearDom type: Real }
    ]
    domainFunctionCode: ''
}
DbToLinearDb >> Units::DbToLinear() >> DbToLinearLinear;

functionTest DbToLinearTest {
    target: DbToLinearDom
    prepare: [
        [ 0.0, -6.0206, 20.0, -20.0 ] >> DbToLinearDb;
    ]
    validate: [
        [ DbToLinearLinear, [ 1.0, 0.5, 10.0, 0.1 ] ] >> Testing::ExpectNear(epsilon: 0.001);
    ]
}
