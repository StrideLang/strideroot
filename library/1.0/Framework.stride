type _PlatformModulePortType {
	typeName: "_platformModulePort"
	properties: [
		typeProperty Name {
			name: "name"
			allowedTypes: _StringLiteral
			required: on
		}
		typeProperty Default {
			name: "default"
			allowedTypes: constrainedEntity { allowed: [_Any, _NoneLiteral] }
			default: none
			required: off
		}
	]

}

type _PlatformCodeType {
	typeName: "_platformCode"
	properties: [
		typeProperty Include {
			name: "include"
			allowedTypes: constrainedList { allowed: [_StringLiteral] }
			default: []
			required: off
		},
		typeProperty IncludeDir {
			name: "includeDir"
			allowedTypes: constrainedList { allowed: [_StringLiteral] }
			default: []
			required: off
		},
		typeProperty LinkTo {
			name: "linkTo"
			allowedTypes: constrainedList { allowed: [_StringLiteral] }
			default: []
			required: off
		},
		typeProperty LinkDir {
			name: "linkDir"
			allowedTypes: constrainedList { allowed: [_StringLiteral] }
			default: []
			required: off
		},
		typeProperty Resources {
			name: "resources"
			allowedTypes: constrainedList { allowed: [_ResourceType, _DomainResourceType, _StringLiteral] }
			default: []
			required: off
			meta: "List of resources required by this object"
		},
		typeProperty GlobalDeclarations {
			name: "globalDeclarations"
			allowedTypes: constrainedList { allowed: [_StringLiteral] }
			default: []
			required: off
		},
		typeProperty GlobalInitializations {
			name: "globalInitializations"
			allowedTypes: constrainedList { allowed: [_StringLiteral] }
			default: []
			required: off
		},
		typeProperty Declarations {
			name: "declarations"
			allowedTypes: constrainedList { allowed: [_StringLiteral] }
			default: []
			required: off
		},
		typeProperty Constructors {
			name: "constructors"
			allowedTypes: constrainedList { allowed: [_StringLiteral] }
			default: []
			required: off
		},
		typeProperty Initializations {
			name: "initializations"
			allowedTypes: constrainedList { allowed: [_StringLiteral] }
			default: []
			required: off
		},
		typeProperty PreProcessingOnce {
			name: "preProcessingOnce"
			allowedTypes: _StringLiteral
			default: ""
			required: off
		},
		typeProperty PreProcessing {
			name: "preProcessing"
			allowedTypes: _StringLiteral
			default: ""
			required: off
		},
		typeProperty Processing {
			name: "processing"
			allowedTypes: _StringLiteral
			default: ""
			required: off
		},
		typeProperty PostProcessing {
			name: "postProcessing"
			allowedTypes: _StringLiteral
			default: ""
			required: off
		},
		typeProperty PostProcessingOnce {
			name: "postProcessingOnce"
			allowedTypes: _StringLiteral
			default: ""
			required: off
		},
		typeProperty Cleanup {
			name: "cleanup"
			allowedTypes: _StringLiteral
			default: ""
			required: off
		},
		typeProperty OutTokens {
			name: "outTokens"
			allowedTypes: constrainedList { allowed: [_StringLiteral] }
			default: []
			required: off
		},
		typeProperty Domain {
			name: "domain"
			allowedTypes: constrainedEntity { allowed: [_DomainDefinition, _StringLiteral, _NoneLiteral] }
			default: none
			required: off
		},
		typeProperty AllowedDomains {
			name: "allowedDomains"
			allowedTypes: constrainedList { allowed: [_DomainDefinition, _StringLiteral] }
			default: []
			required: off
		}
	]
	inherits: [_Base]
}

type _PlatformModuleType {
	typeName: "platformModule"
	properties: [
		typeProperty Inputs {
			name: "inputs"
			allowedTypes: constrainedList { allowed: [_DataTypes, _Variadic, _PlatformModulePortType, _Port, _StringLiteral] }
			default: []
			required: off
		},
		typeProperty Outputs {
			name: "outputs"
			allowedTypes: constrainedList { allowed: [_DataTypes, _Variadic, _PlatformModulePortType, _Port, _StringLiteral] }
			default: []
			required: off
		},
		typeProperty Ports {
			name: "ports"
			allowedTypes: constrainedList { allowed: [_DataTypes, _Variadic, _PlatformModulePortType, _Port, _StringLiteral] }
			default: []
			required: off
		},
		typeProperty Properties {
			name: "propertiesConstraints"
			allowedTypes: constrainedList { allowed: [_TypeProperty, _Constraint, _Any] }
			default: []
			required: off
			meta: "This will validate constraints for property input"
		},
		typeProperty Pure {
			name: "pure"
			allowedTypes: _SwitchLiteral
			default: off
			required: off
			meta: "on when the result depends only on the inputs and the program's definition (no state, no side effects), so the compiler may call it while compiling, for example to fill constants"
		},
		typeProperty Status {
			name: "status"
			allowedTypes: _SwitchLiteral
			default: off
			required: off
			meta: "on when the function reports a status code (stride_status.h): returned, or written through a trailing status pointer when its return value is the result. The compiler ORs it into the domain's status word; Stride code never sees the return value."
		},
		typeProperty ResultSize {
			name: "resultSize"
			allowedTypes: constrainedEntity { allowed: [_StringLiteral, _NoneLiteral] }
			default: none
			required: off
			meta: "For a module whose String result has new characters: how big the result can get, so the caller reserves scratch space for it when compiling. 'sum' (the String inputs' sizes added up), 'format' (the template plus each value's widest text) or 'repeat' (the String input's size times the count). The function then takes the scratch and its size just before the result pointer."
		}
	]
	inherits: [_PlatformCodeType]
}

type _PlatformEntityType {
	typeName: "platformEntity"
	properties: [ 
		typeProperty TypeName {
			name: "typeName"
			allowedTypes: _StringLiteral
			required: on
		},
        typeProperty Rate {
			name: "rate"
			allowedTypes: constrainedEntity { allowed: [_IntLiteral, _RealLiteral, _NoneLiteral] }
			default: -1
			required: off
		}
	]
	inherits: [_PlatformModuleType]
}


# Binds a quality policy (see QualityPolicy.stride) to the specialised
# callables ("Sin@Poly5") that implement a base callable ("Sin") under it.
type _PolicyBinding {
	typeName: "policyBinding"
	properties: [
		typeProperty Policy {
			name: "policy"
			allowedTypes: _Any
			required: on
			meta: "The QualityPolicy entity (e.g. QualityPolicy::Optimal)"
		},
		typeProperty Functions {
			name: "function"
			allowedTypes: constrainedList { allowed: [_Any] }
			required: on
			meta: "List of base callable functions to bind"
		},
		typeProperty Targets {
			name: "target"
			allowedTypes: constrainedList { allowed: [_Any] }
			required: on
			meta: "List of specialized target callables to execute"
		}
	]
	inherits: [_Base]
}

# A concrete device (chip) of a platform, e.g. RP2040 of Pico.
type _DeviceType {
	typeName: "device"
	properties: [
		typeProperty Platform {
			name: "platform"
			allowedTypes: _Any
			required: on
			meta: "Parent platform reference (e.g. Pico)"
		},
		typeProperty Overlays {
			name: "overlays"
			allowedTypes: constrainedEntity { allowed: [_Any, _NoneLiteral] }
			default: none
			required: off
			meta: "Base device for inheritance/overlay (e.g. RP2040)"
		},
		typeProperty Resources {
			name: "resources"
			allowedTypes: constrainedList { allowed: [_ResourceType, _Any] }
			default: []
			required: off
			meta: "Hardware resources owned by this device"
		},
		typeProperty CompilerFlags {
			name: "compilerFlags"
			allowedTypes: _StringLiteral
			default: ""
			required: off
			meta: "Device-specific C/C++ compilation flags"
		},
		typeProperty DevicePolicies {
			name: "devicePolicies"
			allowedTypes: constrainedList { allowed: [_PolicyBinding, _Any] }
			default: []
			required: off
			meta: "List of policyBinding arrays specifying device-level overrides"
		},
		typeProperty Cpu {
			name: "cpu"
			allowedTypes: _StringLiteral
			default: ""
			required: off
			meta: "LLVM CPU name (e.g. atmega328p)"
		},
		typeProperty Clock {
			name: "clock"
			allowedTypes: _IntLiteral
			default: 0
			required: off
			meta: "Core clock in Hz"
		},
		typeProperty Memory {
			name: "memory"
			allowedTypes: _Any
			default: none
			required: off
			meta: "Memory sizes in bytes: { flash: ram: eeprom: }. Merged key by key with the layers below."
		},
		typeProperty Ports {
			name: "ports"
			allowedTypes: constrainedList { allowed: [_Any] }
			default: []
			required: off
			meta: "GPIO ports as named entries: gpioPort B { input: direction: output: } with data-space register addresses"
		},
		typeProperty TickTimer {
			name: "tickTimer"
			allowedTypes: _StringLiteral
			default: ""
			required: off
			meta: "Timer the Stride runtime uses for the domain tick"
		},
		typeProperty RuntimeReserves {
			name: "runtimeReserves"
			allowedTypes: constrainedList { allowed: [_StringLiteral, _Any] }
			default: []
			required: off
			meta: "Peripherals the Stride runtime takes for itself (e.g. Timer0, Usart0)"
		}
	]
	inherits: [_Base]
}

# A processor core family, shared by every platform that uses it, e.g. AVR5
# or CortexM33. Devices overlay a core.
type _CoreType {
	typeName: "core"
	properties: [
		typeProperty Overlays {
			name: "overlays"
			allowedTypes: constrainedEntity { allowed: [_Any, _NoneLiteral] }
			default: none
			required: off
			meta: "A more general core this one extends"
		},
		typeProperty Triple {
			name: "triple"
			allowedTypes: _StringLiteral
			required: on
			meta: "LLVM target triple (e.g. avr, thumbv8m.main-none-eabihf)"
		},
		typeProperty PointerBits {
			name: "pointerBits"
			allowedTypes: _IntLiteral
			required: on
			meta: "Width of a data pointer in bits"
		},
		typeProperty Types {
			name: "types"
			allowedTypes: _Any
			default: none
			required: off
			meta: "Data types behind the generic ones: { int: real: size: }"
		},
		typeProperty HardwareFloat {
			name: "hardwareFloat"
			allowedTypes: _SwitchLiteral
			default: off
			required: off
			meta: "Whether the core has a floating point unit"
		},
		typeProperty Codegen {
			name: "codegen"
			allowedTypes: _StringLiteral
			default: "llvm"
			required: off
			meta: "llvm: Stride's built-in LLVM backend. external: Stride emits code for the core's cc tool."
		},
		typeProperty Frameworks {
			name: "frameworks"
			allowedTypes: constrainedList { allowed: [_StringLiteral] }
			default: []
			required: off
			meta: "Frameworks that can target this core"
		}
	]
	inherits: [_Base]
}

# A board built around a device, e.g. ArduinoUno. Boards overlay a device or
# another board.
type _HardwareBoardType {
	typeName: "hardwareBoard"
	properties: [
		typeProperty Platform {
			name: "platform"
			allowedTypes: _Any
			required: on
			meta: "Parent platform reference (e.g. AVR)"
		},
		typeProperty Overlays {
			name: "overlays"
			allowedTypes: _Any
			required: on
			meta: "The device or board this board is built on"
		},
		typeProperty Pins {
			name: "pins"
			allowedTypes: constrainedList { allowed: [_Any] }
			default: []
			required: off
			meta: "Board pins as named entries: pin D13 { port: B bit: 5 }. A pin with the same name in a board above replaces this one."
		},
		typeProperty Usb {
			name: "usb"
			allowedTypes: constrainedList { allowed: [_StringLiteral] }
			default: []
			required: off
			meta: "USB VID:PID pairs the board shows up as, used to find its port"
		},
		typeProperty Upload {
			name: "upload"
			allowedTypes: _Any
			default: none
			required: off
			meta: "How to flash the board: { method: ... } plus the method's settings"
		},
		typeProperty Image {
			name: "image"
			allowedTypes: constrainedList { allowed: [_Any] }
			default: []
			required: off
			meta: "Steps that turn the linked program into the file that is flashed"
		},
		typeProperty Toolchain {
			name: "toolchain"
			allowedTypes: _Any
			default: none
			required: off
			meta: "Tool for each role, e.g. cc and upload"
		},
		typeProperty Memory {
			name: "memory"
			allowedTypes: _Any
			default: none
			required: off
			meta: "Board changes to device memory, e.g. { bootloader: 512 }"
		}
	]
	inherits: [_Base]
}

type _PlatformType {
	typeName: "platform"
	properties: [
		typeProperty Framework {
			name: "framework"
			allowedTypes: _StringLiteral
			required: on
		},
		typeProperty FrameworkVersion {
			name: "frameworkVersion"
			allowedTypes: constrainedEntity { allowed: [_StringLiteral, _NoneLiteral] }
			default: none
			required: off
		},
		typeProperty Hardware {
			name: "hardware"
			allowedTypes: constrainedEntity { allowed: [_StringLiteral, _NoneLiteral] }
			default: none
			required: off
		},
		typeProperty HardwareVersion {
			name: "hardwareVersion"
			allowedTypes: constrainedEntity { allowed: [_StringLiteral, _NoneLiteral] }
			default: none
			required: off
		},
		typeProperty RootNamespace {
			name: "rootNamespace"
			allowedTypes: _StringLiteral
			default: ""
			required: off
		},
		typeProperty Required {
			name: "required"
			allowedTypes: _SwitchLiteral
			required: on
		},
		typeProperty DefaultDevice {
			name: "defaultDevice"
			allowedTypes: constrainedEntity { allowed: [_Any, _NoneLiteral] }
			default: none
			required: off
			meta: "Default device for this platform (e.g. RP2040)"
		},
		typeProperty SupportedDevices {
			name: "supportedDevices"
			allowedTypes: constrainedList { allowed: [_Any] }
			default: []
			required: off
			meta: "List of supported devices for this platform"
		},
		typeProperty PlatformPolicies {
			name: "platformPolicies"
			allowedTypes: constrainedList { allowed: [_PolicyBinding, _Any] }
			default: []
			required: off
			meta: "List of platform default policyBinding arrays"
		}
	]
}

type _FrameworkDescriptionType {
	typeName: "_frameworkDescription"
	properties: [
		typeProperty FrameworkName {
			name: "frameworkName"
			allowedTypes: _StringLiteral
			required: on
		},
		typeProperty DefaultDataType {
			name: "defaultDataType"
			allowedTypes: constrainedEntity { allowed: [_DataTypes, _StringLiteral] }
			default: Real
			required: off
		},
		typeProperty Inherits {
			name: "inherits"
			allowedTypes: constrainedEntity { allowed: [_StringLiteral, _NoneLiteral] }
			default: none
			required: off
		},
		typeProperty InheritsVersion {
			name: "inheritsVersion"
			allowedTypes: constrainedEntity { allowed: [_StringLiteral, _NoneLiteral] }
			default: none
			required: off
		},
		typeProperty Codegen {
			name: "codegen"
			allowedTypes: _StringLiteral
			default: ""
			required: off
			meta: "llvm when platformModules are LLVM IR, so Stride compiles programs for this framework itself. Empty for C++ template frameworks."
		}
	]
	inherits: [_Base]
}

type _ConnectionType {
	typeName: "connection"
	properties: [
		typeProperty SourceFramework {
			name: "sourceFramework"
			allowedTypes: constrainedEntity { allowed: [_PlatformType, _StringLiteral, _Any] }
			required: on
		},
		typeProperty SourceDomains {
			name: "sourceDomains"
			allowedTypes: constrainedList { allowed: [_StringLiteral, _DomainDefinition] }
			required: on
		},
		typeProperty DestinationFramework {
			name: "destinationFramework"
			allowedTypes: constrainedEntity { allowed: [_PlatformType, _StringLiteral, _Any] }
			required: on
		},
		typeProperty DestinationDomains {
			name: "destinationDomains"
			allowedTypes: constrainedList { allowed: [_StringLiteral, _DomainDefinition] }
			required: on
		},
		typeProperty SourceImports {
			name: "sourceImports"
			allowedTypes: constrainedList { allowed: [_StringLiteral] }
			default: []
			required: off
		},
		typeProperty SourceEntities {
			name: "sourceEntities"
			allowedTypes: constrainedList { allowed: [_PlatformCodeType, _PlatformModuleType, _Any] }
			default: []
			required: off
			meta: "Declarations and platform modules compiled for the source framework/domain"
		},
		typeProperty SourceStreams {
			name: "sourceStreams"
			allowedTypes: constrainedList { allowed: [_StreamType] }
			required: on
		},
		typeProperty DestinationImports {
			name: "destinationImports"
			allowedTypes: constrainedList { allowed: [_StringLiteral] }
			default: []
			required: off
		},
		typeProperty DestinationEntities {
			name: "destinationEntities"
			allowedTypes: constrainedList { allowed: [_PlatformCodeType, _PlatformModuleType, _Any] }
			default: []
			required: off
			meta: "Declarations and platform modules compiled for the destination framework/domain"
		},
		typeProperty DestinationStreams {
			name: "destinationStreams"
			allowedTypes: constrainedList { allowed: [_StreamType] }
			required: on
		}
	]
}

type _SystemType {
	typeName: "system"
	properties: [
		typeProperty Platforms {
			name: "platforms"
			allowedTypes: constrainedList { allowed: [_PlatformType, _StringLiteral, _Any] }
			required: on
		},
        typeProperty Connections {
			name: "connections"
			allowedTypes: constrainedList { allowed: [_ConnectionType] }
			default: []
			required: off
		}
	]
}

type _PlatformOperatorType {
	typeName: "platformOperator"

	properties: [
		typeProperty Type {
			name: "type"
			allowedTypes: constrainedEntity { allowed: [_StringLiteral, _NoneLiteral] }
			default: none
			required: off
		},
		typeProperty LeftTypesProperty {
			name: "leftTypes"
			allowedTypes: constrainedList { allowed: [_Base, _StringLiteral, _Any] }
			default: []
			required: off
		},
		typeProperty RightTypesProperty {
			name: "rightTypes"
			allowedTypes: constrainedList { allowed: [_Base, _StringLiteral, _Any] }
			default: []
			required: off
		},
		typeProperty OutTypesProperty {
			name: "outTypes"
			allowedTypes: constrainedList { allowed: [_Base, _StringLiteral, _Any] }
			default: []
			required: off
		},
		typeProperty LeftDataTypesProperty {
			name: "leftDataTypes"
			allowedTypes: constrainedList { allowed: [_Base, _StringLiteral, _Any] }
			default: []
			required: off
			meta: "Allowed data types for left element"
		},
		typeProperty RightDataTypesProperty {
			name: "rightDataTypes"
			allowedTypes: constrainedList { allowed: [_Base, _StringLiteral, _Any] }
			default: []
			required: off
			meta: "Allowed data types for right element. Leave as none if unary operator"
		},
		typeProperty OutDataTypesProperty {
			name: "outDataTypes"
			allowedTypes: constrainedList { allowed: [_Base, _StringLiteral, _Any] }
			default: []
			required: off
			meta: "Resulting data type from operation"
		}
	]
	inherits: [_PlatformCodeType]
}
