module ExpectMaxError {
	ports: [
		mainInputPort InputPort {
			name: 'input'
			entity: Input
			meta: "Two-element input list for maximum absolute error comparison: [Candidate, Baseline]"
		},
		propertyInputPort MaxTolerancePort {
			name: 'maxError'
			entity: MaxError
			meta: "Maximum allowed absolute error |Candidate - Baseline|"
		}
	]
	entities: [
		signal Input[2] {}
		signal MaxError {
			default: 0.0005
		}
	]
	streams: [
	]
	meta: "Statistical maximum absolute error assertion for stream differential testing."
}

module ExpectSnr {
	ports: [
		mainInputPort InputPort {
			name: 'input'
			entity: Input
			meta: "Two-element input list for Signal-to-Noise Ratio comparison: [Candidate, Baseline]"
		},
		propertyInputPort MinSnrPort {
			name: 'minSnr'
			entity: MinSnr
			meta: "Minimum acceptable Signal-to-Noise Ratio in dB"
		}
	]
	entities: [
		signal Input[2] {}
		signal MinSnr {
			default: 80.0
		}
	]
	streams: [
	]
	meta: "Statistical Signal-to-Noise Ratio assertion for stream differential testing."
}
