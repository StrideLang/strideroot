module Max {
	ports: [
		mainInputPort InputPort {
			entity: Input
			meta: "Two-element input list to compare: [A, B]"
		},
		mainOutputPort OutputPort {
			entity: Output
			meta: "The maximum value"
		}
	]
	entities: [
		signal Input[2] {
			rate: OutputPort.rate
			type: OutputPort.type
			domain: OutputPort.domain
		},
		signal Output {
			rate: OutputPort.rate
			type: OutputPort.type
			domain: OutputPort.domain
		},
		switch Cond {
			rate: OutputPort.rate
			domain: OutputPort.domain
		}
	]
	streams: [
		[Input[0], Input[1]] >> Greater() >> Cond;
		[Cond, Input[0], Input[1]] >> __Select() >> Output;
	]
	meta: "Returns the maximum of two input values in a list: [A, B] >> Max() >> Out."
}

module Min {
	ports: [
		mainInputPort InputPort {
			entity: Input
			meta: "Two-element input list to compare: [A, B]"
		},
		mainOutputPort OutputPort {
			entity: Output
			meta: "The minimum value"
		}
	]
	entities: [
		signal Input[2] {
			rate: OutputPort.rate
			type: OutputPort.type
			domain: OutputPort.domain
		},
		signal Output { 
			rate: OutputPort.rate
			type: OutputPort.type
			domain: OutputPort.domain
		},
		switch Cond {
			rate: OutputPort.rate
			domain: OutputPort.domain
		}
	]
	streams: [
		[Input[0], Input[1]] >> Less() >> Cond;
		[Cond, Input[0], Input[1]] >> __Select() >> Output;
	]
	meta: "Returns the minimum of two input values in a list: [A, B] >> Min() >> Out."
}

module Clamp {
	ports: [
		mainInputPort InputPort {
			entity: Input
			meta: "Input signal to constrain"
		},
		mainOutputPort OutputPort {
			entity: Output
			meta: "Clamped output signal"
		},
		propertyInputPort MinValPort {
			name: "min"
			entity: MinVal
			meta: "Minimum lower bound"
		},
		propertyInputPort MaxValPort {
			name: "max"
			entity: MaxVal
			meta: "Maximum upper bound"
		}
	]
	entities: [
		signal Input  { 
			rate: OutputPort.rate
			type: OutputPort.type
			domain: OutputPort.domain
		}
		signal Output { 
			rate: OutputPort.rate
			type: OutputPort.type
			domain: OutputPort.domain
		}
		signal MinVal { 
			rate: OutputPort.rate
			type: OutputPort.type
			domain: OutputPort.domain
			default: 0.0
		}
		signal MaxVal { 
			rate: OutputPort.rate
			type: OutputPort.type
			domain: OutputPort.domain
			default: 1.0
		}
		signal Temp   { 
			rate: OutputPort.rate
			type: OutputPort.type
			domain: OutputPort.domain
		}
	]
	streams: [
		[Input, MinVal] >> Max() >> Temp;
		[Temp, MaxVal]  >> Min() >> Output;
	]
	meta: "Constrains input signal between minimum and maximum bounds: Input >> Clamp(min: 0.0 max: 1.0) >> Output."
}

module Floor {	
	ports: [
		mainInputPort InputPort {
			entity: Input
			meta: "Floating point number input"
		},
		mainOutputPort OutputPort {
			entity: Output
			meta: "Largest integer value less than or equal to input"
		}
	]
	entities: [
		signal Input  { 
			rate: OutputPort.rate
			type: OutputPort.type
			domain: OutputPort.domain
		},
		signal Output { 
			rate: OutputPort.rate
			type: OutputPort.type
			domain: OutputPort.domain
		}
	]
	streams: [
		Input >> __Floor() >> Output;
	]
	meta: "Returns input value rounded down to the nearest integer."
}

module Wrap {
	ports: [
		mainInputPort InputPort {
			entity: Input
			meta: "Input signal to wrap"
		},
		mainOutputPort OutputPort {
			entity: Output
			meta: "Wrapped output signal"
		},
		propertyInputPort MinValPort {
			name: "min"
			entity: MinVal
			meta: "Range lower bound"
		},
		propertyInputPort MaxValPort {
			name: "max"
			entity: MaxVal
			meta: "Range upper bound"
		}
	]
	entities: [
		signal Input  { 
			rate: OutputPort.rate
			type: OutputPort.type
			domain: OutputPort.domain
		}
		signal Output { 
			rate: OutputPort.rate
			type: OutputPort.type
			domain: OutputPort.domain
		}
		signal MinVal { 
			rate: OutputPort.rate
			type: OutputPort.type
			domain: OutputPort.domain
			default: 0.0
		}
		signal MaxVal { 
			rate: OutputPort.rate
			type: OutputPort.type
			domain: OutputPort.domain
			default: 1.0
		}
		signal Range  { 
			rate: OutputPort.rate
			type: OutputPort.type
			domain: OutputPort.domain
		}
		signal Offset { 
			rate: OutputPort.rate
			type: OutputPort.type
			domain: OutputPort.domain
		}
		signal ModVal { 
			rate: OutputPort.rate
			type: OutputPort.type
			domain: OutputPort.domain
		}
		signal Quo    { 
			rate: OutputPort.rate
			type: OutputPort.type
			domain: OutputPort.domain
		}
		signal Fl     { 
			rate: OutputPort.rate
			type: OutputPort.type
			domain: OutputPort.domain
		}
	]
	streams: [
		MaxVal - MinVal >> Range;
		Input - MinVal >> Offset;
		Offset / Range >> Quo;
		Quo >> Floor() >> Fl;
		Offset - (Range * Fl) >> ModVal;
		ModVal + MinVal >> Output;
	]
	meta: "Periodically wraps input signal within [min, max): Input >> Wrap(min: 0.0 max: 1.0) >> Output."
}

module Lerp {
	ports: [
		mainInputPort InputPort {
			entity: Input
			meta: "Base input signal"
		},
		mainOutputPort OutputPort {
			entity: Output
			meta: "Interpolated output signal"
		},
		propertyInputPort TargetPort {
			name: "target"
			entity: Target
			meta: "Target signal to blend towards"
		},
		propertyInputPort FactorPort {
			name: "factor"
			entity: Factor
			meta: "Blend factor from 0.0 (Input) to 1.0 (Target)"
		}
	]
	entities: [
		signal Input  { 
			rate: OutputPort.rate
			type: OutputPort.type
			domain: OutputPort.domain
		}
		signal Output { 
			rate: OutputPort.rate
			type: OutputPort.type
			domain: OutputPort.domain
		}
		signal Target { 
			rate: OutputPort.rate
			type: OutputPort.type
			domain: OutputPort.domain
			default: 0.0
		}
		signal Factor { 
			rate: OutputPort.rate
			type: OutputPort.type
			domain: OutputPort.domain
			default: 0.5
		}
	]
	streams: [
		Input + ((Target - Input) * Factor) >> Output;
	]
	meta: "Linearly interpolates from Input to Target based on factor: Input >> Lerp(target: Target factor: 0.5) >> Output."
}

module Map {
	ports: [
		mainInputPort InputPort {
			entity: Input
			meta: "Input value to rescale"
		},
		mainOutputPort OutputPort {
			entity: Output
			meta: "Rescaled output value"
		},
		propertyInputPort InMinPort {
			name: "inMin"
			entity: InMin
			meta: "Source range minimum"
		},
		propertyInputPort InMaxPort {
			name: "inMax"
			entity: InMax
			meta: "Source range maximum"
		},
		propertyInputPort OutMinPort {
			name: "outMin"
			entity: OutMin
			meta: "Target range minimum"
		},
		propertyInputPort OutMaxPort {
			name: "outMax"
			entity: OutMax
			meta: "Target range maximum"
		}
	]
	entities: [
		signal Input  { 
			rate: OutputPort.rate
			type: OutputPort.type
			domain: OutputPort.domain
		}
		signal Output { 
			rate: OutputPort.rate
			type: OutputPort.type
			domain: OutputPort.domain
		}
		signal InMin  { 
			rate: OutputPort.rate
			type: OutputPort.type
			domain: OutputPort.domain
			default: 0.0
		}
		signal InMax  { 
			rate: OutputPort.rate
			type: OutputPort.type
			domain: OutputPort.domain
			default: 1.0
		}
		signal OutMin { 
			rate: OutputPort.rate
			type: OutputPort.type
			domain: OutputPort.domain
			default: 0.0
		}
		signal OutMax { 
			rate: OutputPort.rate
			type: OutputPort.type
			domain: OutputPort.domain
			default: 1.0
		}
		signal Norm   { 
			rate: OutputPort.rate
			type: OutputPort.type
			domain: OutputPort.domain
		}
	]
	streams: [
		(Input - InMin) / (InMax - InMin) >> Norm;
		OutMin + (Norm * (OutMax - OutMin)) >> Output;
	]
	meta: "Linearly maps Input from [inMin, inMax] to [outMin, outMax]: Input >> Map(inMin: 0.0 inMax: 1.0 outMin: 100.0 outMax: 1000.0) >> Output."
}
