#
# Stride Standard DSP Package - Generators
#

package Dsp::Generators

module BandLimitedSaw {
    ports: [
        mainOutputPort OutputPort {
            name: "output"
            entity: Output
            meta: "The module's primary output port."
        },
        propertyInputPort FrequencyPort {
            name: "frequency"
            entity: Frequency
            meta: "The frequency of the oscillator in Hz."
        }
    ]
    entities: [
        signal Output {
            type: OutputPort.type
            default: 0.0
        },
        signal Frequency {
            type: OutputPort.type
            default: 220.0
            rate: FrequencyPort.rate
            domain: FrequencyPort.domain
        },
        signal Osc {
            type: OutputPort.type
            default: 0.0
            rate: OutputPort.rate
            domain: OutputPort.domain
        },
        signal History {
            type: OutputPort.type
            default: 0.0
            rate: OutputPort.rate
            domain: OutputPort.domain
        },
        signal Square {
            type: OutputPort.type
            default: 0.0
            rate: OutputPort.rate
            domain: OutputPort.domain
        },
        signal SafeFrequency {
            type: OutputPort.type
            rate: OutputPort.rate
            domain: OutputPort.domain
        },
        signal Scale {
            type: OutputPort.type
            rate: OutputPort.rate
            domain: OutputPort.domain
        },
        signal PhaseResidue {
            type: OutputPort.type
            default: 0.0
            rate: OutputPort.rate
            domain: OutputPort.domain
        },
        signal Phase {
            type: OutputPort.type
            default: 0.0
            rate: OutputPort.rate
            domain: OutputPort.domain
            reset: ResetPhase
        },
        trigger ResetPhase {},
        reaction CorrectPhase {
            terminateWhen: CorrectPhase_Done
            onTermination: ResetPhase
            entities: [
                trigger CorrectPhase_Done {}
            ]
            streams: [
                Phase - 1.0 >> PhaseResidue;
                on >> CorrectPhase_Done;
            ]
        }
    ]
    streams: [
        Phase + (Frequency / OutputPort.rate) >> Phase;
        [Phase, 1.0] >> GreaterOrEqual() >> CorrectPhase();
        (Phase * 2.0) - 1.0 >> Osc;
        # Differentiated parabolic wave (DPW): differentiating the squared naive
        # saw cancels part of the aliasing. The difference of the squares is
        # scaled by 1 / (4 * phase increment) = rate / (4 * frequency) to bring
        # the output back to the range [-1, 1).
        Osc * Osc >> Square;
        [Frequency, 0.000001] >> Max() >> SafeFrequency;
        OutputPort.rate / (4.0 * SafeFrequency) >> Scale;
        (Square - History) * Scale >> Output;
        Square >> History;
    ]
    meta: "Band-limited sawtooth generator (differentiated parabolic wave, DPW): Saw(frequency: 220.0) >> Out. Output in [-1, 1). The frequency is in Hz and is converted against the rate of the output."
}
