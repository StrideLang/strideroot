#
# Stride Standard DSP Package - Generators
#

package Dsp::Generators

module Sequencer {
    ports: [
        mainInputPort InputPort {
            entity: Input
            meta: "Trigger that advances the sequencer to the next step"
        },
        mainOutputPort OutputPort {
            entity: Output
        },
        propertyInputPort ValuesPort {
            name: "values"
            entity: Values
            meta: "Constant array of step values to cycle through"
        }
    ]
    entities: [
        trigger Input { domain: InputPort.domain },
        signal Output {
            type: OutputPort.type
            domain: OutputPort.domain
        },
        signal Counter {
            default: 0
            domain: InputPort.domain
            type: Size
            reset: CounterReset
        },
        constant Values[ValuesPort.size] {
            value: 0
        },
        trigger CounterReset {
            domain: InputPort.domain
        },
        reaction NextStep {
            streams: [
                Counter + 1 >> Counter;
            ]
            domain: InputPort.domain
        }
    ]
    streams: [
        Values[Counter] >> Output;
        Input >> NextStep();
        [Counter, ValuesPort.size] >> Equal() >> CounterReset;
    ]
    meta: "Cycles through the constant values array, outputting the current step and advancing on each input trigger."
}
