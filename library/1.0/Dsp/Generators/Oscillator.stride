#
# Stride Standard DSP Package - Generators
#

package Dsp::Generators

module Oscillator {
    ports: [
        mainOutputPort OutputPort {
            entity: Output
        },
        propertyInputPort FrequencyPort {
            name: "frequency"
            entity: Frequency
            meta: "The frequency of the oscillator."
        },
        propertyInputPort AmplitudeProperty {
            name: "amplitude"
            entity: Amplitude
            meta: "The amplitude of the oscillator."
        },
        propertyInputPort StartPhaseProperty {
            name: "phase"
            entity: StartPhase
            meta: "The starting phase of the oscillator."
        },
        propertyInputPort ResetPort {
            name: "reset"
            entity: Reset
            meta: "Resets the oscillator to the starting phase."
        }
    ]
    entities: [
        signal Frequency {
            type: OutputPort.type
            default: 440.0
        },
        signal Amplitude {
            type: OutputPort.type
            default: 1.0
        },
        signal Phase {
            type: OutputPort.type
            default: 0.0
            reset: Reset
            domain: OutputPort.domain
        },
        signal Sine {
            type: OutputPort.type
            domain: OutputPort.domain
        },
        signal PhaseInc {
            type: OutputPort.type
            default: 0.0
            domain: FrequencyPort.domain
        },
        switch PhaseOverflow {
            domain: OutputPort.domain
        },
        reaction WrapPhase {
            ports: []
            streams: [
                Phase - Math::TwoPi >> Phase;
            ]
        }
    ]
    streams: [
        Frequency * Math::TwoPi / OutputPort.rate >> PhaseInc;
        Phase >> __Sin() >> Sine;
        Sine * Amplitude >> Output;
        Phase + PhaseInc >> Phase;
        [Phase, Math::TwoPi] >> Greater() >> PhaseOverflow >> WrapPhase();
    ]
    constraints: [
        [OutputPort.rate, 0] >> LessOrEqual() >> Error(message: "The rate of the signal block connected to the main output port of the Oscillator module cannot be less than or equal to zero.");
    ]
    meta: "Bipolar output [-1.0, 1.0] scaled by amplitude."
}

module Impulse {
    ports: [
        mainOutputPort OutputPort {
            entity: Output
        },
        propertyInputPort FrequencyPort {
            name: "frequency"
            entity: Frequency
            meta: "The frequency of the oscillator."
        },
        propertyInputPort AmplitudePort {
            name: "amplitude"
            entity: Amplitude
            meta: "The amplitude of the oscillator."
        }
    ]
    entities: [
        signal Frequency {
            type: OutputPort.type
            default: 440.0
        },
        signal Amplitude {
            type: OutputPort.type
            default: 1.0
        },
        signal Phase {
            type: OutputPort.type
            default: 1.0
            domain: OutputPort.domain
        },
        signal PhaseInc {
            type: OutputPort.type
            default: 0.0
            domain: FrequencyPort.domain
        },
        switch PhaseOverflow {
            domain: OutputPort.domain
        },
        reaction WrapPhase {
            streams: [
                Phase - 1.0 >> Phase;
                1.0 >> Output;
            ]
        }
    ]
    streams: [
        Frequency / OutputPort.rate >> PhaseInc;
        Phase + PhaseInc >> Phase;
        [Phase, 1.0] >> GreaterOrEqual() >> Select(whenOn: 1 whenOff: 0) >> Output;
        [Phase, 1.0] >> GreaterOrEqual() >> PhaseOverflow >> WrapPhase();
    ]
    meta: "Impulse train generator."
}
