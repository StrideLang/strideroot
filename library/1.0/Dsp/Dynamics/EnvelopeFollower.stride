#
# Stride Standard DSP Package - Dynamics: Envelope Follower
#

package Dsp::Dynamics::EnvelopeFollower

# Peak envelope follower with independent attack and release times
module Follower {
    ports: [
        mainInputPort InputPort {
            name: "input"
            entity: Input
            meta: "Input audio signal stream"
        },
        propertyInputPort AttackPort {
            name: "attack"
            entity: AttackTime
            meta: "Attack time constant in seconds: how fast the envelope rises (default 0.01). 0 follows rising peaks instantly"
        },
        propertyInputPort ReleasePort {
            name: "release"
            entity: ReleaseTime
            meta: "Release time constant in seconds: how fast the envelope falls (default 0.1). 0 follows falling levels instantly"
        },
        mainOutputPort OutputPort {
            name: "output"
            entity: Output
            meta: "Extracted unipolar envelope signal"
        }
    ]
    entities: [
        signal Input {
            type: OutputPort.type
            domain: OutputPort.domain
            rate: OutputPort.rate
        },
        signal AttackTime {
            type: OutputPort.type
            domain: OutputPort.domain
            default: 0.01
        },
        signal ReleaseTime {
            type: OutputPort.type
            domain: OutputPort.domain
            default: 0.1
        },
        signal SafeAttack {
            type: OutputPort.type
            domain: OutputPort.domain
        },
        signal SafeRelease {
            type: OutputPort.type
            domain: OutputPort.domain
        },
        signal AttackExp {
            type: OutputPort.type
            domain: OutputPort.domain
        },
        signal ReleaseExp {
            type: OutputPort.type
            domain: OutputPort.domain
        },
        signal AttackPole {
            type: OutputPort.type
            domain: OutputPort.domain
        },
        signal ReleasePole {
            type: OutputPort.type
            domain: OutputPort.domain
        },
        signal AttackCoeff {
            type: OutputPort.type
            domain: OutputPort.domain
        },
        signal ReleaseCoeff {
            type: OutputPort.type
            domain: OutputPort.domain
        },
        signal Coeff {
            type: OutputPort.type
            domain: OutputPort.domain
        },
        signal Rectified {
            type: OutputPort.type
            domain: OutputPort.domain
        },
        signal Env {
            type: OutputPort.type
            domain: OutputPort.domain
            rate: OutputPort.rate
            default: 0.0
        },
        switch IsAttack {
            domain: OutputPort.domain
        },
        signal Output {
            type: OutputPort.type
            domain: OutputPort.domain
            rate: OutputPort.rate
        }
    ]
    streams: [
        # One-pole coefficients from the time constants, converted against the
        # rate of the output: coefficient = 1 - exp(-1 / (time * rate))
        [AttackTime, 0.000001] >> Max() >> SafeAttack;
        [ReleaseTime, 0.000001] >> Max() >> SafeRelease;
        -1.0 / (SafeAttack * OutputPort.rate) >> AttackExp;
        -1.0 / (SafeRelease * OutputPort.rate) >> ReleaseExp;
        AttackExp >> Exp() >> AttackPole;
        ReleaseExp >> Exp() >> ReleasePole;
        1.0 - AttackPole >> AttackCoeff;
        1.0 - ReleasePole >> ReleaseCoeff;

        Input >> Abs() >> Rectified;
        [Rectified, Env] >> Greater() >> IsAttack;
        [IsAttack, AttackCoeff, ReleaseCoeff] >> __Select() >> Coeff;
        # Env is read before it is written, so it keeps its value between ticks
        Env + (Coeff * (Rectified - Env)) >> Env;
        Env >> Output;
    ]
    meta: "Peak envelope follower with attack and release times in seconds: AudioIn >> EnvelopeFollower::Follower(attack: 0.01 release: 0.1) >> Envelope. Times are converted against the rate of the output, so the behaviour does not depend on the sample rate."
}
