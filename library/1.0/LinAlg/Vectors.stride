#
# Stride Standard Library - LinAlg Package: Vector Operations
#

package LinAlg::Vectors

# 2D Dot Product
module Dot2D {
    ports: [
        mainInputPort VectorAPort {
            name: "a"
            entity: VectorA
            meta: "First 2D vector [x, y]"
        },
        propertyInputPort VectorBPort {
            name: "with"
            entity: VectorB
            meta: "Second 2D vector [x, y]"
        },
        mainOutputPort OutputPort {
            name: "output"
            entity: Output
            meta: "Scalar dot product result"
        }
    ]
    entities: [
        signal VectorA[2] { domain: OutputPort.domain rate: OutputPort.rate },
        signal VectorB[2] { domain: OutputPort.domain },
        signal Output { domain: OutputPort.domain rate: OutputPort.rate }
    ]
    streams: [
        (VectorA[0] * VectorB[0]) + (VectorA[1] * VectorB[1]) >> Output;
    ]
    meta: "2D Vector dot product: VecA >> Dot2D(with: VecB) >> Result."
}

# 3D Dot Product
module Dot3D {
    ports: [
        mainInputPort VectorAPort {
            name: "a"
            entity: VectorA
            meta: "First 3D vector [x, y, z]"
        },
        propertyInputPort VectorBPort {
            name: "with"
            entity: VectorB
            meta: "Second 3D vector [x, y, z]"
        },
        mainOutputPort OutputPort {
            name: "output"
            entity: Output
            meta: "Scalar dot product result"
        }
    ]
    entities: [
        signal VectorA[3] { domain: OutputPort.domain rate: OutputPort.rate },
        signal VectorB[3] { domain: OutputPort.domain },
        signal Output { domain: OutputPort.domain rate: OutputPort.rate }
    ]
    streams: [
        (VectorA[0] * VectorB[0]) + (VectorA[1] * VectorB[1]) + (VectorA[2] * VectorB[2]) >> Output;
    ]
    meta: "3D Vector dot product: VecA >> Dot3D(with: VecB) >> Result."
}

# 3D Cross Product
module Cross3D {
    ports: [
        mainInputPort VectorAPort {
            name: "a"
            entity: VectorA
            meta: "First 3D vector [x, y, z]"
        },
        propertyInputPort VectorBPort {
            name: "with"
            entity: VectorB
            meta: "Second 3D vector [x, y, z]"
        },
        mainOutputPort OutputPort {
            name: "output"
            entity: Output
            meta: "Orthogonal cross product 3D vector [x, y, z]"
        }
    ]
    entities: [
        signal VectorA[3] { domain: OutputPort.domain rate: OutputPort.rate },
        signal VectorB[3] { domain: OutputPort.domain },
        signal Output[3] { domain: OutputPort.domain rate: OutputPort.rate }
    ]
    streams: [
        (VectorA[1] * VectorB[2]) - (VectorA[2] * VectorB[1]) >> Output[0];
        (VectorA[2] * VectorB[0]) - (VectorA[0] * VectorB[2]) >> Output[1];
        (VectorA[0] * VectorB[1]) - (VectorA[1] * VectorB[0]) >> Output[2];
    ]
    meta: "3D Vector cross product: VecA >> Cross3D(with: VecB) >> OrthoVec."
}

# 2D Euclidean Norm (Length)
module Norm2D {
    ports: [
        mainInputPort VectorPort {
            name: "vector"
            entity: Vector
            meta: "2D vector [x, y]"
        },
        mainOutputPort OutputPort {
            name: "output"
            entity: Output
            meta: "Euclidean vector magnitude / norm"
        }
    ]
    entities: [
        signal Vector[2] { domain: OutputPort.domain rate: OutputPort.rate },
        signal SumSq { domain: OutputPort.domain },
        signal Output { domain: OutputPort.domain rate: OutputPort.rate }
    ]
    streams: [
        (Vector[0] * Vector[0]) + (Vector[1] * Vector[1]) >> SumSq;
        [SumSq, 0.5] >> Pow() >> Output;
    ]
    meta: "2D Vector Euclidean norm: Vec >> Norm2D() >> Length."
}

# 3D Euclidean Norm (Length)
module Norm3D {
    ports: [
        mainInputPort VectorPort {
            name: "vector"
            entity: Vector
            meta: "3D vector [x, y, z]"
        },
        mainOutputPort OutputPort {
            name: "output"
            entity: Output
            meta: "Euclidean vector magnitude / norm"
        }
    ]
    entities: [
        signal Vector[3] { domain: OutputPort.domain rate: OutputPort.rate },
        signal SumSq { domain: OutputPort.domain },
        signal Output { domain: OutputPort.domain rate: OutputPort.rate }
    ]
    streams: [
        (Vector[0] * Vector[0]) + (Vector[1] * Vector[1]) + (Vector[2] * Vector[2]) >> SumSq;
        [SumSq, 0.5] >> Pow() >> Output;
    ]
    meta: "3D Vector Euclidean norm: Vec >> Norm3D() >> Length."
}

# 2D Vector Normalization (Unit Vector)
module Normalize2D {
    ports: [
        mainInputPort VectorPort {
            name: "vector"
            entity: Vector
            meta: "2D vector [x, y]"
        },
        mainOutputPort OutputPort {
            name: "output"
            entity: Output
            meta: "Normalized unit 2D vector [x, y]"
        }
    ]
    entities: [
        signal Vector[2] { domain: OutputPort.domain rate: OutputPort.rate },
        signal Len { domain: OutputPort.domain },
        signal Output[2] { domain: OutputPort.domain rate: OutputPort.rate }
    ]
    streams: [
        Vector >> Norm2D() >> Len;
        Vector[0] / Len >> Output[0];
        Vector[1] / Len >> Output[1];
    ]
    meta: "Normalizes 2D vector to unit length: Vec >> Normalize2D() >> UnitVec."
}

# 3D Vector Normalization (Unit Vector)
module Normalize3D {
    ports: [
        mainInputPort VectorPort {
            name: "vector"
            entity: Vector
            meta: "3D vector [x, y, z]"
        },
        mainOutputPort OutputPort {
            name: "output"
            entity: Output
            meta: "Normalized unit 3D vector [x, y, z]"
        }
    ]
    entities: [
        signal Vector[3] { domain: OutputPort.domain rate: OutputPort.rate },
        signal Len { domain: OutputPort.domain },
        signal Output[3] { domain: OutputPort.domain rate: OutputPort.rate }
    ]
    streams: [
        Vector >> Norm3D() >> Len;
        Vector[0] / Len >> Output[0];
        Vector[1] / Len >> Output[1];
        Vector[2] / Len >> Output[2];
    ]
    meta: "Normalizes 3D vector to unit length: Vec >> Normalize3D() >> UnitVec."
}
