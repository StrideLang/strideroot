#
# Stride Standard Library - Sensors Package: Signal Conditioning & Fusion
#

package Sensors::Conditioning

# Digital switch / button debounce filter
module Debounce {
    ports: [
        mainInputPort InputPort {
            name: "input"
            entity: Input
            meta: "Raw digital input switch"
        },
        propertyInputPort TimePort {
            name: "time"
            entity: DebounceTime
            meta: "Time in seconds the input must stay different from the output before the output follows it (default 0.01)"
        },
        mainOutputPort OutputPort {
            name: "output"
            entity: Output
            meta: "Debounced output switch"
        }
    ]
    entities: [
        switch Input {
            domain: OutputPort.domain
            rate: OutputPort.rate
        },
        signal DebounceTime {
            type: Real
            domain: OutputPort.domain
            default: 0.01
        },
        signal SamplesNeeded {
            type: Real
            domain: OutputPort.domain
        },
        signal Count {
            type: Real
            domain: OutputPort.domain
            default: 0.0
        },
        signal CountNext {
            type: Real
            domain: OutputPort.domain
        },
        switch Output {
            domain: OutputPort.domain
            rate: OutputPort.rate
            default: off
        },
        switch IsDifferent {
            domain: OutputPort.domain
        },
        switch Accept {
            domain: OutputPort.domain
        }
    ]
    streams: [
        # The time is converted to a number of ticks with the rate of the output
        DebounceTime * OutputPort.rate >> SamplesNeeded;

        # Count consecutive ticks in which the input differs from the output.
        # Count and Output are read before they are written, so they keep their
        # value between ticks.
        [Input, Output] >> Xor() >> IsDifferent;
        [IsDifferent, Count + 1.0, 0.0] >> __Select() >> CountNext;
        [CountNext, SamplesNeeded] >> GreaterOrEqual() >> Accept;
        [Accept, Input, Output] >> __Select() >> Output;
        [Accept, 0.0, CountNext] >> __Select() >> Count;
    ]
    meta: "Suppresses mechanical switch bounce: RawButton >> Debounce(time: 0.01) >> CleanButton. The output follows the input once it has been different for the given time in seconds, converted against the rate of the output."
}

# Deadband filter with linear rescaling to prevent analog joystick/sensor jitter
module Deadband {
    ports: [
        mainInputPort InputPort {
            name: "input"
            entity: Input
            meta: "Input signal in range [-1.0, 1.0]"
        },
        propertyInputPort ThresholdPort {
            name: "threshold"
            entity: Threshold
            meta: "Deadband half-width around zero (default 0.05)"
        },
        mainOutputPort OutputPort {
            name: "output"
            entity: Output
            meta: "Deadband-filtered and rescaled output signal"
        }
    ]
    entities: [
        signal Input {
            type: OutputPort.type
            domain: OutputPort.domain
            rate: OutputPort.rate
        },
        signal Threshold {
            type: OutputPort.type
            domain: OutputPort.domain
            default: 0.05
        },
        signal AbsIn {
            type: OutputPort.type
            domain: OutputPort.domain
        },
        signal Scaled {
            type: OutputPort.type
            domain: OutputPort.domain
        },
        signal ClampedScaled {
            type: OutputPort.type
            domain: OutputPort.domain
        },
        signal SignVal {
            type: OutputPort.type
            domain: OutputPort.domain
        },
        signal Output {
            type: OutputPort.type
            domain: OutputPort.domain
            rate: OutputPort.rate
        }
    ]
    streams: [
        Input >> Abs() >> AbsIn;
        (AbsIn - Threshold) / (1.0 - Threshold) >> Scaled;
        [Scaled, 0.0] >> Max() >> ClampedScaled;
        Input >> Sign() >> SignVal;
        ClampedScaled * SignVal >> Output;
    ]
    meta: "Suppresses near-zero sensor jitter with smooth linear rescaling: Joystick >> Deadband(threshold: 0.05) >> Output."
}

# Linear ADC calibration mapping [rawMin, rawMax] to physical units [calMin, calMax]
module LinearCalibration {
    ports: [
        mainInputPort InputPort {
            name: "input"
            entity: Input
            meta: "Raw sensor measurement (e.g., ADC integer counts)"
        },
        propertyInputPort RawMinPort {
            name: "rawMin"
            entity: RawMin
            meta: "Minimum raw input value"
        },
        propertyInputPort RawMaxPort {
            name: "rawMax"
            entity: RawMax
            meta: "Maximum raw input value"
        },
        propertyInputPort CalMinPort {
            name: "calMin"
            entity: CalMin
            meta: "Target calibrated minimum engineering unit"
        },
        propertyInputPort CalMaxPort {
            name: "calMax"
            entity: CalMax
            meta: "Target calibrated maximum engineering unit"
        },
        mainOutputPort OutputPort {
            name: "output"
            entity: Output
            meta: "Calibrated physical signal"
        }
    ]
    entities: [
        signal Input {
            type: OutputPort.type
            domain: OutputPort.domain
            rate: OutputPort.rate
        },
        signal RawMin {
            type: OutputPort.type
            domain: OutputPort.domain
            default: 0.0
        },
        signal RawMax {
            type: OutputPort.type
            domain: OutputPort.domain
            default: 1023.0
        },
        signal CalMin {
            type: OutputPort.type
            domain: OutputPort.domain
            default: 0.0
        },
        signal CalMax {
            type: OutputPort.type
            domain: OutputPort.domain
            default: 3.3
        },
        signal Normalized {
            type: OutputPort.type
            domain: OutputPort.domain
        },
        signal Output {
            type: OutputPort.type
            domain: OutputPort.domain
            rate: OutputPort.rate
        }
    ]
    streams: [
        (Input - RawMin) / (RawMax - RawMin) >> Normalized;
        CalMin + (Normalized * (CalMax - CalMin)) >> Output;
    ]
    meta: "Rescales raw ADC readings to engineering units: Adc >> LinearCalibration(rawMin: 0 rawMax: 4095 calMin: 0.0 calMax: 3.3) >> Volts."
}

# 1st-order complementary filter combining gyroscope angular velocity with accelerometer tilt
module ComplementaryFilter {
    ports: [
        mainInputPort GyroPort {
            name: "gyroRate"
            entity: GyroRate
            meta: "Angular velocity from gyroscope in angle units per second (e.g. rad/s)"
        },
        propertyInputPort AccelPort {
            name: "accelAngle"
            entity: AccelAngle
            meta: "Static tilt angle from accelerometer, in the same angle unit"
        },
        propertyInputPort TimeConstantPort {
            name: "timeConstant"
            entity: TimeConstant
            meta: "Crossover time in seconds: for changes slower than this the accelerometer is trusted, for faster changes the gyroscope (default 0.5)"
        },
        mainOutputPort AnglePort {
            name: "angle"
            entity: OutputAngle
            meta: "Fused estimated angle"
        }
    ]
    entities: [
        signal GyroRate {
            type: AnglePort.type
            domain: AnglePort.domain
            rate: AnglePort.rate
        },
        signal AccelAngle {
            type: AnglePort.type
            domain: AnglePort.domain
            default: 0.0
        },
        signal TimeConstant {
            type: AnglePort.type
            domain: AnglePort.domain
            default: 0.5
        },
        signal Dt {
            type: AnglePort.type
            domain: AnglePort.domain
        },
        signal Alpha {
            type: AnglePort.type
            domain: AnglePort.domain
        },
        signal PrevAngle {
            type: AnglePort.type
            domain: AnglePort.domain
            default: 0.0
        },
        signal GyroIntegrated {
            type: AnglePort.type
            domain: AnglePort.domain
        },
        signal OutputAngle {
            type: AnglePort.type
            domain: AnglePort.domain
            rate: AnglePort.rate
        }
    ]
    streams: [
        # The sample interval is the period of the output rate; the blend factor
        # follows from the crossover time: alpha = tau / (tau + dt)
        1.0 / AnglePort.rate >> Dt;
        TimeConstant / (TimeConstant + Dt) >> Alpha;
        PrevAngle + (GyroRate * Dt) >> GyroIntegrated;
        (GyroIntegrated * Alpha) + (AccelAngle * (1.0 - Alpha)) >> OutputAngle;
        OutputAngle >> PrevAngle;
    ]
    meta: "IMU sensor fusion blending gyro rate and accelerometer tilt: GyroRate >> ComplementaryFilter(accelAngle: AccelTilt timeConstant: 0.5) >> FusedAngle. The sample interval and the blend factor are derived from the rate of the output; the type must be floating point."
}
