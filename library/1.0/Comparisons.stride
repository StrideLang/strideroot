loop AllOn {
    ports: [
        mainInputPort InputPort {
            block: Input
            meta: "Array of switches to be checked"
        },
        mainOutputPort OutputPort {
            block: Output
            meta: "Switch that is on only if all input switches are on"
        }
    ]
    blocks: [
        switch Input[InputPort.size] {
            rate: OutputPort.rate
            domain: OutputPort.domain
        },
        switch Output {
            default: on
            rate: OutputPort.rate
            domain: OutputPort.domain
            reset: Reset
        },
        signal Index {
            default: 0
            rate: none
            type: _IntType
            domain: OutputPort.domain
            reset: Reset
        },
        switch Done {
            domain: OutputPort.domain
        },
        trigger Reset {}
    ]
    onExecution: Reset
    terminateWhen: Done
    streams: [
        [Output, Input[Index]] >> And() >> Output;
        Index + 1 >> Index;
        [Index, InputPort.size] >> Equal() >> Done;
    ]
    meta: "Outputs on if all switches in the input array are on: Input >> AllOn() >> Output."
}

loop AllOff {
    ports: [
        mainInputPort InputPort {
            block: Input
            meta: "Array of switches to be checked"
        },
        mainOutputPort OutputPort {
            block: Output
            meta: "Switch that is on only if all input switches are off"
        }
    ]
    blocks: [
        switch Input[InputPort.size] {
            rate: OutputPort.rate
            domain: OutputPort.domain
        },
        switch Output {
            default: on
            rate: OutputPort.rate
            domain: OutputPort.domain
            reset: Reset
        },
        switch InputOff {
            rate: OutputPort.rate
            domain: OutputPort.domain
        },
        signal Index {
            default: 0
            rate: none
            type: _IntType
            domain: OutputPort.domain
            reset: Reset
        },
        switch Done {
            domain: OutputPort.domain
        },
        trigger Reset {}
    ]
    onExecution: Reset
    terminateWhen: Done
    streams: [
        Input[Index] >> Not() >> InputOff;
        [Output, InputOff] >> And() >> Output;
        Index + 1 >> Index;
        [Index, InputPort.size] >> Equal() >> Done;
    ]
    meta: "Outputs on if all switches in the input array are off: Input >> AllOff() >> Output."
}
