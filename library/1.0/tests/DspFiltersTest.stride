# DspFiltersTest.stride
# Unit tests for strideroot/library/1.0/Dsp/Filters (and FilterDesign).
#
# The filters convert their frequency against the rate of the output, so each
# test runs the filter in a domain with a known rate (1000 Hz here). Expected
# values come from the RBJ Audio EQ Cookbook difference equation evaluated
# independently in Python (impulse and step responses).

import Dsp::Filters as Filters
import Dsp::FilterDesign as FilterDesign

_domainDefinition LowPassDom {
    framework: _JitFramework
    rate: 1000
    substitutions: []
    domainIncludes: []
    inputs: [
        signal LowPassIn { domain: LowPassDom type: Real }
    ]
    outputs: [
        signal LowPassOut { domain: LowPassDom type: Real }
    ]
    domainFunctionCode: ''
}
LowPassIn >> Filters::LowPass(frequency: 100.0 q: 0.7071) >> LowPassOut;

functionTest LowPassImpulseTest {
    target: LowPassDom
    prepare: [
        [ 1.000000, 0.000000, 0.000000, 0.000000, 0.000000, 0.000000, 0.000000, 0.000000, 0.000000, 0.000000 ] >> LowPassIn;
    ]
    validate: [
        [ LowPassOut, [ 0.067455, 0.212010, 0.281932, 0.234725, 0.151904, 0.076729, 0.024994, -0.003106, -0.013868, -0.014568 ] ] >> ExpectNear(epsilon: 0.0001);
    ]
}

