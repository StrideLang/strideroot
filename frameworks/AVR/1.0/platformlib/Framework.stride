#
# AVR framework: Stride programs compiled by Stride's own LLVM backend for
# 8-bit AVR microcontrollers (Arduino Uno and compatible boards), without
# the Arduino build system.
#
# platformModules are LLVM IR or calls into the small C runtime in
# ../runtime, which provides main(), the Timer0 tick and the serial port.
#

import Codegen

_frameworkDescription _AvrFramework {
    frameworkName: "AVR"
    defaultDataType: Real
    codegen: Codegen::Llvm
}

alias PlatformDomain {
    entity: AvrTickDomain
}

alias PlatformRate {
    entity: 1000
}

# Standard platform domains. Programs that use these instead of AVR's own
# domain names run unchanged on other frameworks that provide them.

# Runs again as soon as it finishes, like Arduino's loop(). Sleep suspends
# only this domain.
alias PlatformLoopDomain {
    entity: AvrLoopDomain
}

# Runs periodically from a hardware timer at PlatformTimerRate. On AVR it is
# cooperative: it runs from main() between loop iterations.
alias PlatformTimerDomain {
    entity: AvrTickDomain
}

alias PlatformTimerRate {
    entity: 1000
}
