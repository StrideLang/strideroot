module Divide {
	ports: [
		mainInputPort InputPort {
			entity: Input
			meta: "Two-element input list: [Numerator, Denominator]" 
		},
		mainOutputPort OutputPort {
			entity: Output
			meta: "The quotient of the division" 
		}
	]
	entities: [
		signal Input[2] { 
			rate: OutputPort.rate
			type: OutputPort.type
			domain: OutputPort.domain
			meta: "Input values"
		},
		signal Output { 
			rate: OutputPort.rate
			type: OutputPort.type
			domain: OutputPort.domain
			meta: "Result of the division"
		}
	]
	streams: [
		Input[0] / Input[1] >> Output;
	]
	meta: "Divides Input[0] by Input[1]."
}

