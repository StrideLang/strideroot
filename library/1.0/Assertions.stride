# Assertions.stride

module ExpectEqual {
	ports: [
		mainInputPort InputPort {
			name: 'input'
			entity: Input
			meta: "Two-element input list with values expected to be equal: [Actual, Expected]"
		}
	]
	entities: [
		signal Input[2] {}
	]
	streams: [
	]
	meta: "Equality assertion module. Declared for schema validation; handled with special treatment in the testing framework."
}

module ExpectNear {
	ports: [
		mainInputPort InputPort {
			name: 'input'
			entity: Input
			meta: "Two-element input list with values expected to be close: [Actual, Expected]"
		},
		propertyInputPort EpsilonPort {
			name: 'epsilon'
			entity: Epsilon
			meta: "Tolerance threshold for approximate comparison"
		}
	]
	entities: [
		signal Input[2] {}
		signal Epsilon {
			default: 0.0001
		}
	]
	streams: [
	]
	meta: "Approximate equality assertion within epsilon tolerance. Declared for schema validation; handled with special treatment in the testing framework."
}

module ExpectTrue {
	ports: [
		mainInputPort InputPort {
			name: 'input'
			entity: Input
			meta: "Condition value expected to be true (on)"
		}
	]
	entities: [
		switch Input {}
	]
	streams: [
	]
	meta: "Condition assertion (true). Declared for schema validation; handled with special treatment in the testing framework."
}

module ExpectFalse {
	ports: [
