# The USB serial port (USART0). The runtime opens it at the board's baud
# rate before the first tick; writes go through a ring buffer sent by the
# transmit interrupt, so they don't block the tick unless the buffer is full.

platformModule __AvrSerialWriteByte {
    inputs: [UInt8]
    outputs: []
    processing: "@__stride_avr_serial_write_byte"
    inherits: [_Signal]
}

platformModule __AvrSerialPrintInt {
    inputs: [Int]
    outputs: []
    processing: "@__stride_avr_serial_print_int"
    inherits: [_Signal]
}

platformModule __AvrSerialPrintReal {
    inputs: [Real]
    outputs: []
    processing: "@__stride_avr_serial_print_real"
    inherits: [_Signal]
}

# Ends the line ("\r\n"). To print text, use Print and PrintLn
# (Strings.stride): they write to this port.
platformModule __AvrSerialNewLine {
    inputs: []
    outputs: []
    processing: "@__stride_avr_serial_newline"
    inherits: [_Signal]
}

# The next received byte, or -1 when none has arrived.
platformModule __AvrSerialReadByte {
    inputs: []
    outputs: [Int]
    processing: "@__stride_avr_serial_read_byte"
    inherits: [_Signal]
}
