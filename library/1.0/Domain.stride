type _DomainDefinition {
	typeName: "_domainDefinition"
	properties: [
        typeProperty Substitutions {
			name: "substitutions"
			allowedTypes: constrainedList { allowed: [_Any] }
			default: []
			required: off
		},
		typeProperty Framework {
			name: "framework"
			allowedTypes: constrainedEntity { allowed: [_StringLiteral, _FrameworkDescriptionType, _NoneLiteral] }
			required: on
		},
		typeProperty ParentDomain {
			name: "parentDomain"
			allowedTypes: constrainedEntity { allowed: [_StringLiteral, _DomainDefinition, _NoneLiteral] }
			default: none
			required: off
			meta: "The domain's parent domain."
		},
		typeProperty MaxInstances {
			name: "maxInstances"
			allowedTypes: constrainedEntity { allowed: [_IntLiteral, _NoneLiteral] }
			default: none
			required: off
			meta: "The maximum number of instances of this domain that can be created. Setting to none means no limit"
		},
		typeProperty DomainRate {
			name: "rate"
			allowedTypes: constrainedEntity { allowed: [_RealLiteral, _IntLiteral, _MemberAccess, _Constant, _NoneLiteral] }
			required: on
			default: none
			public: on
			meta: "The domain's rate. A value of none indicates an asynchronous or immediate domain."
		},
		typeProperty Trigger {
			name: "trigger"
			allowedTypes: constrainedEntity { allowed: [_Switch, _Trigger, _MemberAccess, _Entity, _NoneLiteral] }
			default: none
			required: off
			meta: "Switch, trigger, gpioPin interrupt, or buffer readiness (e.g. Buf.ready) that ticks a reactive subdomain."
		},
		typeProperty QualityPolicyProperty {
			name: "qualityPolicy"
			allowedTypes: constrainedEntity { allowed: [_Any, _NoneLiteral] }
			default: none
			required: off
			meta: "The active quality policy entity for this domain (e.g. QualityPolicy::Optimal)"
		},
		typeProperty VariantPolicyProperty {
			name: "variantPolicy"
			allowedTypes: constrainedList { allowed: [_StringLiteral] }
			default: []
			required: off
			meta: "Explicit list of variant tags to search in order (e.g. ['Poly5', 'Table1024'])"
		},
		typeProperty External {
			name: "external"
			allowedTypes: constrainedList { allowed: [_Signal, _Switch] }
			default: []
			required: off
			meta: "Signals and switches in this domain that are owned outside the domain.
					Within the domain they behave as belonging to the domain"
		},
		typeProperty RequiresResources {
			name: "requiresResources"
			allowedTypes: constrainedList { allowed: [_ResourceType, _DomainResourceType, _StringLiteral] }
			default: []
			required: off
			meta: "A list of resources required by the domain"
		},
		typeProperty ProvidesResources {
			name: "providesResources"
			allowedTypes: constrainedList { allowed: [_ResourceType, _DomainResourceType, _StringLiteral] }
			default: []
			required: off
			meta: "A list of resources provided by the domain"
		},
		typeProperty Inputs {
			name: "inputs"
			allowedTypes: constrainedList { allowed: [_Streamable] }
			default: []
			required: off
		},
		typeProperty Outputs {
			name: "outputs"
			allowedTypes: constrainedList { allowed: [_Streamable] }
			default: []
			required: off
		},
		typeProperty OnLoad {
			name: "onLoad"
			allowedTypes: constrainedList { allowed: [_StreamType] }
			default: []
			required: off
			meta: "Streams that prepare what every instance of the domain shares, such as tables in constants without a value (GridRaySectionTable() >> RaySection;). They run once per program, in order, before the first instance of the domain starts: starting an instance loads the domain first if it is not loaded yet, and later instances find it loaded. They run outside any instance, so they see the blocks of the root scope (constants) and not the domain's blocks, inputs or outputs. They should give the same result whenever they run, so a host may also load the domain before its first instance."
		},
		typeProperty OnInit {
			name: "onInit"
			allowedTypes: constrainedList { allowed: [_StreamType] }
			default: []
			required: off
			meta: "Streams that prepare one instance of the domain, such as placing a game's starting pieces (Create_Black();). They run in order every time an instance starts or restarts, before any other part of its start: after the domain is loaded (so they can read what onLoad prepared), but before the domain's blocks take their default values and its state machines enter their initial states. Every block has a default, so a value they write to a block of the domain is replaced when the blocks are reset after them: what they do lasts only through what they call outside the domain, such as a host's functions. They run inside the instance, so they can read the domain's blocks and inputs as well as the root scope. Calling <Domain>_init again requires calling <Domain>_cleanup first."
		},
		typeProperty OnReset {
			name: "onReset"
			allowedTypes: constrainedList { allowed: [_StreamType] }
			default: []
			required: off
			meta: "Streams that reset or initialize runtime domain blocks (such as signal arrays or buffers). They run at the end of <Domain>_reset (and at the end of <Domain>_init), after defaults, state machines, and buffer counters have been reset, so values written to domain blocks persist. Safe to call via <Domain>_reset while the domain is initialized."
		},
#		typeProperty GlobalsTag {
#			name: "globalsTag"
#			allowedTypes: _StringLiteral
#			default: "Includes"
#			required: off
#		},
#		typeProperty DeclarationsTag {
#			name: "declarationsTag"
#			allowedTypes: _StringLiteral
#			default: ""
#			required: off
#		},
#		typeProperty ProcessingTag {
#			name: "processingTag"
#			allowedTypes: _StringLiteral
#			default: ""
#			required: off
#		},
#		typeProperty InitializationTag {
#			name: "initializationTag"
#			allowedTypes: _StringLiteral
#			default: ""
#			required: off
#		},
#		typeProperty CleanupTag {
#			name: "cleanupTag"
#			allowedTypes: _StringLiteral
#			default: ""
#			required: off
#		},
		typeProperty DomainIncludes {
			name: "domainIncludes"
			allowedTypes: constrainedList { allowed: [_StringLiteral] }
			default: []
			required: off
		},
		typeProperty DomainDeclarations {
			name: "domainDeclarations"
			allowedTypes: constrainedList { allowed: [_StringLiteral] }
			default: []
			required: off
		},
		typeProperty DomainDeclarationsCode {
			name: "domainDeclarationsCode"
			allowedTypes: _StringLiteral
			default: ""
			required: off
		},

		typeProperty DomainInstancesCode {
			name: "domainInstancesCode"
			allowedTypes: _StringLiteral
			default: ""
			required: off
		},
		typeProperty DomainInitializationCode {
			name: "domainInitializationCode"
			allowedTypes: _StringLiteral
			default: ""
			required: off
		},
		typeProperty DomainFunctionCode {
			name: "domainFunctionCode"
			allowedTypes: _StringLiteral
			default: ""
			required: off
			meta: 'Declaration of the domain processing function. Use //[[Processing]]//[[/Processing]] to mark where the generated code needs to be placed within 
			the domain function'
		},
		typeProperty DomainProcessingCode {
			name: "domainProcessingCode"
			allowedTypes: _StringLiteral
			default: ""
			required: off
			meta: 'Processing code for domain. Code to be called
			by a parent domain to update or tick the domain.'
		},
		typeProperty DomainCleanupCode {
			name: "domainCleanupCode"
			allowedTypes: _StringLiteral
			default: ""
			required: off
		},
		typeProperty StateMachines {
			name: "stateMachines"
			allowedTypes: constrainedList { allowed: [_StateType] }
			default: []
			required: off
			meta: "State machines executed continuously within this domain."
		},
		typeProperty SleepModule {
			name: "sleepModule"
			allowedTypes: constrainedEntity { allowed: [_Any, _NoneLiteral] }
			default: none
			required: off
			meta: "A platformModule that suspends only this domain. It takes one integer input: the number of ticks to sleep, at sleepRate ticks per second. Sleep(domain: ThisDomain) calls it. Without it, Sleep counts ticks for a subdomain, or blocks."
		},
		typeProperty SleepRate {
			name: "sleepRate"
			allowedTypes: constrainedEntity { allowed: [_IntLiteral, _RealLiteral, _NoneLiteral] }
			default: none
			required: off
			meta: "Ticks per second of sleepModule's input. The domain's rate when absent."
		},
		typeProperty Execution {
			name: "execution"
			allowedTypes: constrainedEntity { allowed: [_DomainExecution, _NoneLiteral] }
			default: none
			required: off
			meta: "How this domain runs relative to the others: ExecutionCooperative, ExecutionInterrupt, ExecutionThread, ExecutionInline or ExecutionHardware. See _DomainExecution. none means ExecutionCooperative."
		},
		typeProperty PreSubdomains {
			name: "preSubdomains"
			allowedTypes: constrainedList { allowed: [_DomainDefinition, _StringLiteral] }
			default: []
			required: off
			meta: "Parent-ticked subdomains executed in order before this domain's streams."
		},
		typeProperty PostSubdomains {
			name: "postSubdomains"
			allowedTypes: constrainedList { allowed: [_DomainDefinition, _StringLiteral] }
			default: []
			required: off
			meta: "Parent-ticked subdomains executed in order after this domain's streams and stateMachines."
		}
	]
	inherits: [_Base, _Callable]
}

module Exit {
    ports: [
        mainInputPort MainInputPort { entity: Input }
		# TODO add secondary port taking return value.
    ]
    entities: [
        switch Input {}
    ]
    streams: [
        Input >> reaction { streams: [ 1 >> __ExitDomain(); ]}; #TODO set return value dynamically
    ]
	meta: 'When input is true, the current domain terminates without executing any further.'
}

module Sleep {
    ports: [
        mainInputPort DurationPort {
            name: "duration"
            entity: Duration
            meta: "Duration to sleep in seconds"
        },
        propertyInputPort DomainPort {
            name: "domain"
            entity: TargetDomain
            meta: "The domain that sleeps"
        }
    ]
    entities: [
        signal Duration {
            default: 0.0
            type: Real
            domain: DurationPort.domain
        }
    ]
    streams: [
    ]
    meta: 'Suspends the specified domain (and all parent synchronous domains) for the given duration in seconds: 0.5 >> Sleep(domain: MyDomain);'
}

# How a domain runs relative to the other domains (_domainDefinition's
# execution property). A typeClass of constants: a schema property with
# allowedTypes: _DomainExecution accepts exactly these names.
constant ExecutionCooperative {
	value: 0
	meta: "Runs on the same thread as its sibling domains, between their process calls. A long computation in a sibling delays it; it can share signals with siblings without synchronization."
}

constant ExecutionInterrupt {
	value: 1
	meta: "Runs from an interrupt handler and preempts cooperative domains. Shared state and read-modify-write registers need care."
}

constant ExecutionThread {
	value: 2
	meta: "Runs on its own OS thread or core. Shared signals go through synchronization declarations."
}

constant ExecutionInline {
	value: 3
	meta: "Runs inside its parent's process call (preSubdomains, postSubdomains) and shares the parent's timing."
}

constant ExecutionHardware {
	value: 4
	meta: "Runs in hardware without the CPU, such as an FPGA clock domain, a PIO state machine or a DMA stream."
}

typeClass _DomainExecution {
	types: [ExecutionCooperative, ExecutionInterrupt, ExecutionThread, ExecutionInline, ExecutionHardware]
}
