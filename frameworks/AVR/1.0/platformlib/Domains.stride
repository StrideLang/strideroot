resource _RootContext {
	dependsOn: []
	exclusive: none
	meta: 'The microcontroller: one core, no threads'
}

resource _AvrProcessor {
	dependsOn: [_RootContext]
	exclusive: off
	meta: 'Single-core 8-bit AVR CPU shared cooperatively by domains in main()'
}

resource _AvrFlashMemory {
	dependsOn: [_RootContext]
	exclusive: off
	meta: 'Shared program flash memory for code and constants'
}

resource _AvrSram {
	dependsOn: [_RootContext]
	exclusive: off
	meta: 'Shared SRAM for domain state, globals, stack, and ring buffers'
}

resource _AvrEeprom {
	dependsOn: [_RootContext]
	exclusive: off
	meta: 'Shared non-volatile EEPROM'
}

resource _AvrTimer0 {
	dependsOn: [_RootContext]
	exclusive: off
	meta: 'Shared Timer0 peripheral and 1 kHz tick/millis ISR'
}

resource _AvrUsart0 {
	dependsOn: [_RootContext]
	exclusive: off
	meta: 'Shared USART0 serial peripheral and TX/RX ring buffers'
}

resource _AvrGpio {
	dependsOn: [_RootContext]
	exclusive: off
	meta: 'Shared GPIO ports and pins'
}

resource _AvrMathLib {
	dependsOn: [_RootContext]
	exclusive: off
	meta: 'AVR libm floating-point math routines'
}

resource _AvrTimer1 {
	dependsOn: [_RootContext]
	exclusive: on
	isrVector: "TIMER1_COMPA_vect"
	peripheral: "Timer1"
	meta: '16-bit Timer1 CTC interrupt'
}

domainResource _DomainFunction {
	exclusive: on # Takes over _RootContext resource
	meta: 'Function the runtime calls from main()'
}

# Runs once, before the first tick.
_domainDefinition RootDomain {
	framework: _AvrFramework
	requiresResources: [_RootContext, _AvrProcessor, _AvrFlashMemory, _AvrSram, _AvrTimer0, _AvrUsart0, _AvrGpio, _AvrMathLib]
	providesResources: [_DomainFunction]
	rate: -1 # -1 is 'one-shot/final' domain
	sleepModule: __AvrSleepMs
	sleepRate: 1000
    substitutions: [ ]
    domainIncludes: []
	domainFunctionCode: ''
}

# The 1 kHz tick loop. Child of RootDomain; the runtime calls
# AvrTickDomain_process() once per Timer0 tick, 1000 times a second,
# before AvrLoopDomain_process() in each main() loop iteration.
_domainDefinition AvrTickDomain {
	framework: _AvrFramework
	parentDomain: RootDomain
	requiresResources: [_RootContext, _AvrProcessor, _AvrFlashMemory, _AvrSram, _AvrTimer0, _AvrUsart0, _AvrGpio, _AvrMathLib]
	providesResources: [_DomainFunction]
	rate: 1000
	# Runs from main(), between loop iterations: a long loop iteration
	# delays its ticks, which then run back to back.
	execution: ExecutionCooperative
	sleepModule: __AvrTickSleep
	sleepRate: 1000
    substitutions: [ ]
    domainIncludes: []
	domainFunctionCode: ''
}

# Continuous main loop. Child of RootDomain; the runtime calls
# AvrLoopDomain_process() on every iteration of the main() loop after
# pending AvrTickDomain ticks have been processed.
_domainDefinition AvrLoopDomain {
	framework: _AvrFramework
	parentDomain: RootDomain
	requiresResources: [_RootContext, _AvrProcessor, _AvrFlashMemory, _AvrSram, _AvrTimer0, _AvrUsart0, _AvrGpio, _AvrMathLib]
	providesResources: [_DomainFunction]
	rate: 0
	execution: ExecutionCooperative
	# Sleep suspends only the loop: main() keeps running tick domains.
	sleepModule: __AvrLoopSleep
	sleepRate: 1000
    substitutions: [ ]
    domainIncludes: []
	domainFunctionCode: ''
}

# Hardware Timer1 CTC interrupt domain. Preempts cooperative domains;
# excludes _AvrTimer0 (no Sleep), _AvrUsart0 (no Serial), and _AvrMathLib
# (uses QualityPolicy::Fast polynomial approximations).
_domainDefinition AvrTimer1IsrDomain {
	framework: _AvrFramework
	parentDomain: RootDomain
	requiresResources: [_RootContext, _AvrProcessor, _AvrFlashMemory, _AvrSram, _AvrGpio, _AvrTimer1]
	rate: 8000
	execution: ExecutionInterrupt
	qualityPolicy: QualityPolicy::Fast
	sleepModule: none
    substitutions: [ ]
    domainIncludes: []
	domainFunctionCode: ''
}

# Suspends AvrTickDomain for the given number of Timer0 ticks (1 ms each).
platformModule __AvrTickSleep {
	inputs: [UInt32]
	outputs: []
	resources: [_AvrTimer0]
	processing: "@__stride_avr_tick_sleep"
	inherits: [_Signal]
}

# Suspends AvrLoopDomain for the given number of milliseconds. main() skips
# the loop until the time has passed and keeps processing ticks meanwhile.
platformModule __AvrLoopSleep {
	inputs: [UInt32]
	outputs: []
	resources: [_AvrTimer0]
	processing: "@__stride_avr_loop_sleep"
	inherits: [_Signal]
}

# Blocks for the given number of milliseconds using the Timer0 tick.
platformModule __AvrSleepMs {
	inputs: [UInt32]
	outputs: []
	resources: [_AvrTimer0]
	processing: "@__stride_avr_sleep_ms"
	inherits: [_Signal]
}
