# DspNonlinearTest.stride
# Unit tests for strideroot/library/1.0/Dsp/Nonlinear (package Dsp::Nonlinear::Saturate)

import Dsp::Nonlinear::Saturate as Saturate
import Testing as Testing

# f(x) = 1.5 * (c - c^3 / 3) with c = clamp(x, -1, 1)
_domainDefinition SoftClipDom {
    framework: _JitFramework
    rate: -1
    substitutions: []
    domainIncludes: []
    inputs: [
        signal SoftClipInput { domain: SoftClipDom type: Real }
    ]
    outputs: [
        signal SoftClipOutput { domain: SoftClipDom type: Real }
    ]
    domainFunctionCode: ''
}
SoftClipInput >> Saturate::SoftClip() >> SoftClipOutput;

functionTest SoftClipTest {
    target: SoftClipDom
    prepare: [
        [ -2.0, -0.5, 0.0, 0.5, 2.0 ] >> SoftClipInput;
    ]
    validate: [
        [ SoftClipOutput, [ -1.0, -0.6875, 0.0, 0.6875, 1.0 ] ] >> Testing::ExpectNear(epsilon: 0.0001);
    ]
}

# Pade [3/2] approximation of tanh on [-3, 3], x clamped outside
_domainDefinition TanhDom {
    framework: _JitFramework
    rate: -1
    substitutions: []
    domainIncludes: []
    inputs: [
        signal TanhInput { domain: TanhDom type: Real }
    ]
    outputs: [
        signal TanhOutput { domain: TanhDom type: Real }
    ]
    domainFunctionCode: ''
}
TanhInput >> Saturate::Tanh() >> TanhOutput;

functionTest TanhTest {
    target: TanhDom
    prepare: [
        [ -5.0, -2.0, 0.0, 0.5, 3.0 ] >> TanhInput;
    ]
    validate: [
        [ TanhOutput, [ -1.0, -0.984127, 0.0, 0.465812, 1.0 ] ] >> Testing::ExpectNear(epsilon: 0.0001);
    ]
}

_domainDefinition TanhIsBoundedDom {
    framework: _JitFramework
    rate: -1
    substitutions: []
    domainIncludes: []
    inputs: [
        signal TanhIsBoundedInput { domain: TanhIsBoundedDom type: Real }
    ]
    outputs: [
        signal TanhIsBoundedOutput { domain: TanhIsBoundedDom type: Real }
    ]
    domainFunctionCode: ''
}
TanhIsBoundedInput >> Saturate::Tanh() >> TanhIsBoundedOutput;

functionTest TanhIsBoundedTest {
    target: TanhIsBoundedDom
    prepare: [
        [ -100.0, -10.0, 10.0, 100.0 ] >> TanhIsBoundedInput;
    ]
    validate: [
        [ TanhIsBoundedOutput, [ 1.0, 1.0, 1.0, 1.0 ] ] >> Testing::ExpectLe();
        [ TanhIsBoundedOutput, [ -1.0, -1.0, -1.0, -1.0 ] ] >> Testing::ExpectGe();
    ]
}
