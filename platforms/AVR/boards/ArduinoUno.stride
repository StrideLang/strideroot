#
# Arduino Uno (R3 and compatible clones) with the optiboot bootloader.
#
# Other boards overlay this one or ATmega328P: a Nano is the Uno's pinout on
# a smaller board, so it only needs its own USB IDs and upload settings, plus
# pin entries for A6 and A7. A pin entry with the same name replaces this
# board's.
#
# A project uses a pin through a gpioPin in its own hardware file, which
# names the label with this board's name: pin: ArduinoUno::D13. LED is a
# second label for D13, the on-board LED.
#

package ArduinoUno

import ATmega328P
import Flasher

hardwareBoard ArduinoUno {
    platform: AVR
    overlays: ATmega328P
    pins: [
        pin D0 { port: PortD bit: 0 },
        pin D1 { port: PortD bit: 1 },
        pin D2 { port: PortD bit: 2 },
        pin D3 { port: PortD bit: 3 },
        pin D4 { port: PortD bit: 4 },
        pin D5 { port: PortD bit: 5 },
        pin D6 { port: PortD bit: 6 },
        pin D7 { port: PortD bit: 7 },
        pin D8 { port: PortB bit: 0 },
        pin D9 { port: PortB bit: 1 },
        pin D10 { port: PortB bit: 2 },
        pin D11 { port: PortB bit: 3 },
        pin D12 { port: PortB bit: 4 },
        pin D13 { port: PortB bit: 5 },
        pin A0 { port: PortC bit: 0 adc: 0 },
        pin A1 { port: PortC bit: 1 adc: 1 },
        pin A2 { port: PortC bit: 2 adc: 2 },
        pin A3 { port: PortC bit: 3 adc: 3 },
        pin A4 { port: PortC bit: 4 adc: 4 },
        pin A5 { port: PortC bit: 5 adc: 5 },
        pin LED { port: PortB bit: 5 }
    ]
    usb: ["2341:0043", "2341:0001", "2341:0243", "2A03:0043", "1A86:7523"]
    flashers: [ avrdude Avrdude { programmer: "arduino" baud: 115200 } ]
    image: [
        step Hex { kind: "hex" }
    ]
    toolchain: {
        cc: "AvrGcc"
        ar: "AvrGcc"
        ld: "AvrGcc"
        objcopy: "AvrGcc"
        size: "AvrGcc"
        upload: "Avrdude"
    }
    memory: {
        bootloader: 512
    }
    meta: "Arduino Uno: ATmega328P at 16 MHz, USB serial, optiboot"
}
