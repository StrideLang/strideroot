		}
	]
	entities: [
		signal Input[2] { 
			rate: OutputPort.rate
			type: OutputPort.type
			domain: OutputPort.domain
		},
		signal Output { 
			rate: OutputPort.rate
			type: OutputPort.type
			domain: OutputPort.domain
		}
	]
	streams: [
		Input[0] * Input[1] >> Output;
	]
	meta: "Multiplies Input[0] by Input[1]."
}

module Inverse {
	ports: [
		mainInputPort InputPort {
			entity: Input
			meta: "Value to negate"
		},
		mainOutputPort OutputPort {
			entity: Output
			meta: "The negated value"
