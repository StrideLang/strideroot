#
# Stride Standard DSP Package - Filters: BandPass
#

package Dsp::Filters

import Dsp::FilterDesign as FilterDesign

# Second-order band-pass filter with constant 0 dB peak gain
module BandPass {
	ports: [
		mainInputPort InputPort {
			name: "input"
			entity: Input
			meta: "Input signal"
		},
		mainOutputPort OutputPort {
			name: "output"
			entity: Output
			meta: "Filtered output signal"
		},
		propertyInputPort FrequencyPort {
			name: "frequency"
			entity: Frequency
			meta: "Centre frequency in Hz (default 1000.0)"
		},
		propertyInputPort QPort {
			name: "q"
			entity: Q
			meta: "Quality factor (default 1.0). Bandwidth in octaves is about 1.44 / q: higher values give a narrower band"
		}
	]
	entities: [
		signal Input {
			type: OutputPort.type
			rate: OutputPort.rate
			domain: OutputPort.domain
		},
		signal Output {
			type: OutputPort.type
			rate: OutputPort.rate
			domain: OutputPort.domain
		},
		signal Frequency {
			type: OutputPort.type
			rate: OutputPort.rate
			domain: OutputPort.domain
			default: 1000.0
		},
		signal Q {
			type: OutputPort.type
			domain: OutputPort.domain
			default: 1.0
		}
	]
	streams: [
		Input >> BiQuad(mode: FilterDesign::ModeBandPass frequency: Frequency q: Q) >> Output;
	]
	meta: "Second-order band-pass filter: Input >> BandPass(frequency: 1000.0 q: 2.0) >> Output. A BiQuad with FilterDesign::ModeBandPass. The frequency is in Hz and is converted against the rate of the output. The data type must be floating point."
}
