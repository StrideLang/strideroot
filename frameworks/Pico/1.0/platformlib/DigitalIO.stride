# GPIO register access for the portable DigitalIO library modules
# (DigitalIO::DigitalOut, DigitalIn, Led). The compiler fills in each pin's
# addresses and masks from the board, so these are LLVM IR with constant
# operands: a pin write becomes a single store to SIO GPIO_OUT_SET / GPIO_OUT_CLR.
# Pico's SIO GPIO registers are 32 bits wide.

platformModule _GpioWrite {
    inputs: [Switch, UInt32, UInt32, UInt32, UInt32, Switch]
    outputs: []
    processing: "llvm::gpio write i32 %%intokens:0%%, %%intokens:1%%, %%intokens:2%%, %%intokens:3%%, %%intokens:4%%, %%intokens:5%%"
    inherits: [_Signal]
}

platformModule _GpioRead {
    inputs: [UInt32, UInt32]
    outputs: [Switch]
    processing: "%%outtokens:0%% = llvm::gpio read i32 %%intokens:0%%, %%intokens:1%%"
    inherits: [_Signal]
}

platformModule _GpioModify {
    inputs: [UInt32, UInt32, UInt32, Switch]
    outputs: []
    processing: "llvm::gpio modify i32 %%intokens:0%%, %%intokens:1%%, %%intokens:2%%, %%intokens:3%%"
    inherits: [_Signal]
}

# Pin mode by GP number: 0 input, 1 output, 2 input pull-up, 3 input pull-down.
platformModule __PicoPinMode {
    inputs: [Int, Int]
    outputs: []
    processing: "@__stride_pico_pin_mode"
    inherits: [_Signal]
}

# Drives an output pin high (on) or low (off) by GP number.
platformModule __PicoPinWrite {
    inputs: [Int, Switch]
    outputs: []
    processing: "@__stride_pico_pin_write"
    inherits: [_Signal]
}

# Reads a pin by GP number: on when high.
platformModule __PicoPinRead {
    inputs: [Int]
    outputs: [Switch]
    processing: "@__stride_pico_pin_read"
    inherits: [_Signal]
}

# Milliseconds since boot.
platformModule __PicoMillis {
    inputs: []
    outputs: [UInt32]
    processing: "@__stride_pico_millis"
    inherits: [_Signal]
}
