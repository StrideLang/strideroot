# Counter.stride
# Clocked signal accumulator with modulo wrapping and reset for Stride

module Counter {
    ports: [
        mainOutputPort OutputPort {
            entity: Output
            meta: "Counter output signal"
        },
        propertyInputPort StartValuePort {
            name: "startValue"
            entity: StartValue
            meta: "The starting value of the counter, which is also the first output value."
        },
        propertyInputPort StopValuePort {
            name: "stopValue"
            entity: StopValue
            meta: "The roll value of the counter. The maximum value before resetting to startValue."
        },
        propertyInputPort IncrementPort {
            name: "increment"
            entity: Increment
            meta: "The step value added per tick."
        },
        propertyInputPort ResetPort {
            name: "reset"
            entity: Reset
            meta: "The counter is reset to startValue when a trigger arrives at the reset port."
        }
    ]
    entities: [
        signal StartValue {
            default: 0
            domain: OutputPort.domain
        },
        signal StopValue {
            default: 100
            domain: OutputPort.domain
        },
        signal Increment {
            default: 1
            domain: OutputPort.domain
        },
        trigger Reset {
            domain: OutputPort.domain
        },
        signal Output {
            default: 0
            domain: OutputPort.domain
            reset: Reset
        }
    ]
    streams: [
        Output + Increment >> Output;
        [Output, StopValue] >> Greater() >> reaction { StartValue >> Output; };
    ]    
    meta: "A discrete step counter that increments per tick and rolls over to startValue upon exceeding stopValue."
}
