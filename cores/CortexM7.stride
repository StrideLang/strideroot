#
# ARM Cortex-M7 core family (ARMv7E-M, 32-bit pointers, hardware FPU).
#
# Shared across platforms built on Cortex-M7 (such as STMicroelectronics STM32F7).
# Devices overlay this core and add their memory, clock, and peripherals.
#

package CortexM7

import Codegen

core CortexM7 {
    # eabi, not eabihf: code uses the FPU but passes floats in core registers
    # (softfp), the ABI the STM32 runtime and its C library are built for.
    triple: "thumbv7em-none-eabi"
    pointerBits: 32
    types: {
        int: "Int32"
        real: "Float32"
        size: "UInt32"
    }
    hardwareFloat: on
    cacheLine: 32
    codegen: Codegen::Llvm
    meta: "ARM Cortex-M7 (ARMv7E-M), 32-bit pointers, hardware FPU, 32-byte cache line"
}
