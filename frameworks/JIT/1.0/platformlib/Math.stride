
platformModule __Abs {
    inputs: [Real]
    outputs: [Real]
    linkTo: ["m"]
    processing: "@fabs"
    inherits: [_Signal]
}

platformModule __Floor {
    inputs: [Real]
    outputs: [Real]
    linkTo: ["m"]
    processing: "@floor"
    inherits: [_Signal]
}

