#
# Pico framework: Stride programs compiled by Stride's own LLVM backend for
# Raspberry Pi Pico boards (RP2040 Cortex-M0+ and RP2350 Cortex-M33), linked
# against pico-sdk.
#
# platformModules are LLVM IR or calls into the C runtime in ../runtime,
# which provides main(), the 1 kHz repeating timer tick, and USB/UART stdio.
#

import Codegen

_frameworkDescription _PicoFramework {
    frameworkName: "Pico"
    defaultDataType: Real
    codegen: Codegen::Llvm
}

alias PlatformDomain {
    entity: PicoTickDomain
}

alias PlatformRate {
    entity: 1000
}

# Standard platform domains. Programs that use these instead of Pico's own
# domain names run unchanged on other frameworks that provide them.

# Runs again as soon as it finishes, like Arduino's loop(). Sleep suspends
# only this domain.
alias PlatformLoopDomain {
    entity: PicoLoopDomain
}

# Runs periodically at PlatformTimerRate. Cooperative: runs from main()
# between loop iterations.
alias PlatformTimerDomain {
    entity: PicoTickDomain
}

alias PlatformTimerRate {
    entity: 1000
}
