#
# Stride Standard DSP Package - Generators
#

package Dsp::Generators

loop FillSineTable {
    ports: [
        mainOutputPort OutputPort {
            entity: Output
        }
    ]
    entities: [
        signal Output[OutputPort.size] {
            type: OutputPort.type
            domain: OutputPort.domain
        },
        iterator Out {
            entity: Output
        }
    ]
    streams: [
        Oscillator(frequency: 1.0) >> RateAdapter(rate: OutputPort.size) >> Out;
    ]
}

module TableOscillator {
    ports: [
        mainOutputPort OutputPort {
            entity: Output
        },
        propertyInputPort FrequencyPort {
            name: "frequency"
            entity: Frequency
            meta: "Oscillator frequency in Hz (default 440.0)."
        },
        propertyInputPort AmplitudeProperty {
            name: "amplitude"
            entity: Amplitude
            meta: "Peak amplitude multiplier (default 1.0)."
        },
        propertyInputPort StartPhaseProperty {
            name: "phase"
            entity: StartPhase
            meta: "Initial phase (default 0.0)."
        },
        propertyInputPort ResetPort {
            name: "reset"
            entity: Reset
            meta: "Resets the oscillator to the starting phase."
        }
    ]
    entities: [
        signal Frequency {
            type: OutputPort.type
            default: 440.0
        },
        signal Amplitude {
            type: OutputPort.type
            default: 1.0
        },
        constant TableSize {
            value: 1024
        },
        signal SineTable[TableSize] {
            type: OutputPort.type
            domain: OutputPort.domain
        },
        switch TableNeedsInit {
            default: on
            domain: OutputPort.domain
        },
        reaction InitTable {
            streams: [
                FillSineTable() >> SineTable;
                off >> TableNeedsInit;
            ]
        },
        signal Phase {
            type: OutputPort.type
            default: 0.0
            reset: Reset
            domain: OutputPort.domain
        },
        signal PhaseInc {
            type: OutputPort.type
            default: 0.0
            domain: FrequencyPort.domain
        },
        switch PhaseOverflow {
            domain: OutputPort.domain
        },
        reaction WrapPhase {
            streams: [
                Phase - TableSize >> Phase;
            ]
        }
    ]
    streams: [
        TableNeedsInit >> InitTable();
        Frequency * TableSize / OutputPort.rate >> PhaseInc;
        SineTable[Phase] * Amplitude >> Output;
        Phase + PhaseInc >> Phase;
        [Phase, TableSize] >> Greater() >> PhaseOverflow >> WrapPhase();
    ]
    meta: "1024-sample wavetable sine oscillator with bipolar output [-1.0, 1.0] scaled by amplitude."
}
