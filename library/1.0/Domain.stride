type _DomainDefinition {
	typeName: "_domainDefinition"
	properties: [
        typeProperty Substitutions {
			name: "substitutions"
			allowedTypes: constrainedList { allowed: [_Any] }
			default: []
			required: off
		},
		typeProperty Framework {
			name: "framework"
			allowedTypes: constrainedEntity { allowed: [_StringLiteral, _FrameworkDescriptionType, _NoneLiteral] }
			required: on
		},
		typeProperty ParentDomain {
			name: "parentDomain"
			allowedTypes: constrainedEntity { allowed: [_StringLiteral, _DomainDefinition, _NoneLiteral] }
			default: none
			required: off
			meta: "The domain's parent domain."
		},
		typeProperty MaxInstances {
			name: "maxInstances"
			allowedTypes: constrainedEntity { allowed: [_IntLiteral, _NoneLiteral] }
			default: none
			required: off
			meta: "The maximum number of instances of this domain that can be created. Setting to none means no limit"
		},
		typeProperty DomainRate {
			name: "rate"
			allowedTypes: constrainedEntity { allowed: [_RealLiteral, _IntLiteral, _NoneLiteral] }
			required: on
			meta: "The domain's rate. A value of none indicates an asynchronous or immediate domain."
		},
		typeProperty QualityPolicyProperty {
			name: "qualityPolicy"
			allowedTypes: constrainedEntity { allowed: [_Any, _NoneLiteral] }
			default: none
			required: off
			meta: "The active quality policy entity for this domain (e.g. QualityPolicy::Optimal)"
		},
		typeProperty VariantPolicyProperty {
			name: "variantPolicy"
			allowedTypes: constrainedList { allowed: [_StringLiteral] }
			default: []
			required: off
			meta: "Explicit list of variant tags to search in order (e.g. ['Poly5', 'Table1024'])"
		},
		typeProperty External {
			name: "external"
			allowedTypes: constrainedList { allowed: [_Signal, _Switch] }
			default: []
			required: off
			meta: "Signals and switches in this domain that are owned outside the domain.
					Within the domain they behave as belonging to the domain"
		},
		typeProperty RequiresResources {
			name: "requiresResources"
			allowedTypes: constrainedList { allowed: [_ResourceType] }
			default: []
			required: off
			meta: "A list of resources required by the domain"
		},
		typeProperty ProvidesResources {
			name: "providesResources"
			allowedTypes: constrainedList { allowed: [_DomainResourceType] }
			default: []
			required: off
			meta: "A list of resources provided by the domain"
		},
		typeProperty Inputs {
			name: "inputs"
			allowedTypes: constrainedList { allowed: [_Streamable, _Port, _Any] }
			default: []
			required: off
		},
		typeProperty Outputs {
			name: "outputs"
			allowedTypes: constrainedList { allowed: [_Streamable, _Port, _Any] }
			default: []
			required: off
		},
		typeProperty OnLoad {
			name: "onLoad"
			allowedTypes: constrainedList { allowed: [_StreamType] }
			default: []
			required: off
			meta: "Streams that prepare what every instance of the domain shares, such as tables in constants without a value (GridRaySectionTable() >> RaySection;). They run once per program, in order, before the first instance of the domain starts: starting an instance loads the domain first if it is not loaded yet, and later instances find it loaded. They run outside any instance, so they see the blocks of the root scope (constants) and not the domain's blocks, inputs or outputs. They should give the same result whenever they run, so a host may also load the domain before its first instance."
		},
		typeProperty OnInit {
			name: "onInit"
			allowedTypes: constrainedList { allowed: [_StreamType] }
			default: []
			required: off
			meta: "Streams that prepare one instance of the domain, such as placing a game's starting pieces (Create_Black();). They run in order every time an instance starts or restarts, before any other part of its start: after the domain is loaded (so they can read what onLoad prepared), but before the domain's blocks take their default values and its state machines enter their initial states. Every block has a default, so a value they write to a block of the domain is replaced when the blocks are reset after them: what they do lasts only through what they call outside the domain, such as a host's functions. They run inside the instance, so they can read the domain's blocks and inputs as well as the root scope."
		},
#		typeProperty GlobalsTag {
#			name: "globalsTag"
#			allowedTypes: _StringLiteral
#			default: "Includes"
#			required: off
#		},
#		typeProperty DeclarationsTag {
#			name: "declarationsTag"
#			allowedTypes: _StringLiteral
#			default: ""
#			required: off
#		},
#		typeProperty ProcessingTag {
#			name: "processingTag"
#			allowedTypes: _StringLiteral
#			default: ""
#			required: off
#		},
#		typeProperty InitializationTag {
#			name: "initializationTag"
#			allowedTypes: _StringLiteral
#			default: ""
#			required: off
#		},
#		typeProperty CleanupTag {
#			name: "cleanupTag"
#			allowedTypes: _StringLiteral
#			default: ""
#			required: off
#		},
		typeProperty DomainIncludes {
			name: "domainIncludes"
			allowedTypes: constrainedList { allowed: [_StringLiteral] }
			default: []
			required: off
		},
		typeProperty DomainDeclarations {
			name: "domainDeclarations"
			allowedTypes: constrainedList { allowed: [_StringLiteral] }
			default: []
			required: off
		},
		typeProperty DomainDeclarationsCode {
			name: "domainDeclarationsCode"
			allowedTypes: _StringLiteral
			default: ""
			required: off
		},

		typeProperty DomainInstancesCode {
			name: "domainInstancesCode"
			allowedTypes: _StringLiteral
			default: ""
			required: off
		},
		typeProperty DomainInitializationCode {
			name: "domainInitializationCode"
			allowedTypes: _StringLiteral
			default: ""
			required: off
		},
		typeProperty DomainFunctionCode {
			name: "domainFunctionCode"
			allowedTypes: _StringLiteral
			default: ""
			required: off
			meta: 'Declaration of the domain processing function. Use //[[Processing]]//[[/Processing]] to mark where the generated code needs to be placed within 
			the domain function'
		},
		typeProperty DomainProcessingCode {
			name: "domainProcessingCode"
			allowedTypes: _StringLiteral
			default: ""
			required: off
			meta: 'Processing code for domain. Code to be called
			by a parent domain to update or tick the domain.'
		},
		typeProperty DomainCleanupCode {
			name: "domainCleanupCode"
			allowedTypes: _StringLiteral
			default: ""
			required: off
		},
		typeProperty StateMachines {
			name: "stateMachines"
			allowedTypes: constrainedList { allowed: [_StateType] }
			default: []
			required: off
			meta: "State machines executed continuously within this domain."
		}
	]
#	inherits: [_Base]
}

module Exit {
    ports: [
        mainInputPort MainInputPort { block: Input }
		# TODO add secondary port taking return value.
    ]
    blocks: [
        switch Input {}
    ]
    streams: [
        Input >> reaction { streams: [ 1 >> __ExitDomain(); ]}; #TODO set return value dynamically
    ]
	meta: 'When input is true, the current domain terminates without executing any further.'
}
