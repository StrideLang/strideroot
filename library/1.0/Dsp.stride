#
# Stride Standard DSP & Audio Synthesis Package Root (barrel file)
#
# This file only re-exports sub-packages. Level, Pan and Crossfade live in
# Dsp::Routing; there is deliberately a single definition of each module.
#
#   Dsp::Generators    Oscillator, Impulse, TableOscillator, BandLimitedSaw, AD, Sequencer
#   Dsp::Filters       BiQuad (all RBJ responses), LowPass, HighPass, BandPass, Notch, AllPass, ...
#   Dsp::FilterDesign  RBJ cookbook coefficient calculators
#   Dsp::Routing       Level, Pan, Crossfade
#   Dsp::Units         Note frequencies, MidiToFreq, DbToLinear
#   Dsp::Spectral      Goertzel tone detector
#   Dsp::Delay         Fractional delay line
#   Dsp::Dynamics      Envelope follower, compressor, limiter
#   Dsp::Nonlinear     Saturators
#
# Importing `Dsp` registers the sub-packages below. Generators, Filters,
# FilterDesign, Routing and Units are imported on demand, e.g.
# `import Dsp::Filters as Filters`.
#

package Dsp

import Dsp::Spectral as Spectral
import Dsp::Delay as Delay
import Dsp::Dynamics as Dynamics
import Dsp::Nonlinear as Nonlinear
