#
# STMicroelectronics STM32F746NG (TFBGA216): an STM32F7xx with 1 MB of flash and 320 KB of SRAM
# at 0x20000000 (DTCM, SRAM1 and SRAM2 in one block).
#

import STM32F7xx

device STM32F746NG {
    platform: STM32F7
    overlays: STM32F7xx
    memory: {
        flash: 1048576
        ram: 327680
    }
    resources: [CortexM7HardwareFpuSp]
    flashers: [
        probeRs ProbeRs { chip: "STM32F746NGHx" }
    ]
    meta: "STM32F746NG ARM Cortex-M7 @ 216 MHz, 1 MB flash, 320 KB SRAM, single-precision FPU"
}
