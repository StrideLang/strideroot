#
# Stride Standard DSP Package - Spectral: Goertzel Single-Tone Detector
#

package Dsp::Spectral::Goertzel

module Detector {
    ports: [
        mainInputPort InputPort {
            name: "input"
            entity: Input
            meta: "Audio or sensor input stream"
        },
        propertyInputPort FreqPort {
            name: "frequency"
            entity: TargetFreq
            meta: "Target tone frequency in Hz to detect"
        },
        mainOutputPort PowerPort {
            name: "power"
            entity: Power
            meta: "Instantaneous signal power at target frequency"
        }
    ]
    entities: [
        signal Input {
            type: PowerPort.type
            domain: PowerPort.domain
            rate: PowerPort.rate
        },
        signal TargetFreq {
            type: PowerPort.type
            domain: PowerPort.domain
            default: 440.0
        },
        signal Omega {
            type: PowerPort.type
            domain: PowerPort.domain
        },
        signal CosOmega {
            type: PowerPort.type
            domain: PowerPort.domain
        },
        signal Coeff {
            type: PowerPort.type
            domain: PowerPort.domain
        },
        signal S0 {
            type: PowerPort.type
            domain: PowerPort.domain
        },
        signal S1 {
            type: PowerPort.type
            domain: PowerPort.domain
            default: 0.0
        },
        signal S2 {
            type: PowerPort.type
            domain: PowerPort.domain
            default: 0.0
        },
        signal Power {
            type: PowerPort.type
            domain: PowerPort.domain
            rate: PowerPort.rate
        }
    ]
    streams: [
        # Normalized target frequency and 2nd-order IIR recursion coefficient
        # The sample rate is the rate of the output, so the frequency in Hz is converted against it
        (Math::TwoPi * TargetFreq) / PowerPort.rate >> Omega;
        Omega >> Cos() >> CosOmega;
        2.0 * CosOmega >> Coeff;

        # Goertzel 2nd-order difference equation: s[n] = x[n] + 2*cos(w)*s[n-1] - s[n-2]
        Input + (Coeff * S1) - S2 >> S0;

        # Power estimate: P = s1^2 + s2^2 - 2*cos(w)*s1*s2
        (S1 * S1) + (S2 * S2) - (Coeff * S1 * S2) >> Power;

        # State updates
        S1 >> S2;
        S0 >> S1;
    ]
    meta: "Goertzel single-frequency power detector: AudioIn >> Goertzel::Detector(frequency: 440.0) >> TonePower. The frequency is in Hz and is converted against the rate of the output (the sample rate). Type must be floating point."
}
