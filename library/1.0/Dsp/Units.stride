# Unit Conversions

module MidiToFreq {
	ports: [
		mainInputPort NotePort {
			name: "note"
			entity: Note
			meta: "MIDI note number [0-127] where 69 = A4 (440Hz)"
		},
		mainOutputPort FrequencyPort {
			name: "frequency"
			entity: Frequency
			meta: "Frequency in Hertz"
		}
	]
	entities: [
		signal Note { domain: NotePort.domain },
		signal Ratio {},
		signal Frequency { domain: FrequencyPort.domain }
	]
	streams: [
		[2.0, (Note - 69.0) / 12.0] >> Pow() >> Ratio;
		440.0 * Ratio >> Frequency;
	]
	meta: "Converts MIDI note number to frequency in Hertz."
}

module DbToLinear {
	ports: [
		mainInputPort DbPort {
			name: "db"
			entity: Db
			meta: "Amplitude in decibels (dB)"
		},
		mainOutputPort LinearPort {
			name: "linear"
			entity: Linear
			meta: "Linear amplitude ratio"
		}
	]
	entities: [
		signal Db { domain: DbPort.domain },
		signal Linear { domain: LinearPort.domain }
	]
	streams: [
		[10.0, Db / 20.0] >> Pow() >> Linear;
	]
	meta: "Converts decibels (dB) to linear amplitude ratio."
}
