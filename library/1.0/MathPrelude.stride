	]
	entities: [
		signal Input  { 
			rate: OutputPort.rate
			type: OutputPort.type
			domain: OutputPort.domain
		},
		signal Output { 
			rate: OutputPort.rate
			type: OutputPort.type
			domain: OutputPort.domain
		}
	]
	streams: [
		-Input >> Output;
	]
	meta: "Inverts (changes the sign of) an input value: -Input."
}

