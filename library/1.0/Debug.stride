module DebugPrint {
	ports: [
		mainInputPort ValueProperty {
			name: "value"
			entity: Value
			meta: "Value to print to debug output"
		}
		propertyInputPort TriggerPort {
			name: "trigger"
			entity: Trigger
			meta: "Switch or trigger controlling when to print (default on)"
		}
	]
    entities: [
		signal Value { default: 0.0 },
		switch Trigger { default: on },
		reaction Print {
			streams: [
				Value >> __DebugPrint();
			]
		}
    ]
    streams: [
		Trigger >> Print();
    ]
    meta: "Prints a value to the debug output when trigger is on."
}

module Error {
	ports: [
		mainInputPort TriggerPort {
			entity: Trigger
			meta: "Switch or trigger that raises the error when on"
		}
		propertyInputPort MessagePort {
			name: "message"
			entity: Message
			meta: "Error message string"
		}
	]
	streams: [
	]
	meta: "Raises a compile-time or runtime error with message when triggered."
}

module Probe {
	ports: [
		mainInputPort InputPort {
			name: "input"
			entity: Input
			meta: "Signal to be probed and passed through"
		}
		mainOutputPort OutputPort {
			name: "output"
			entity: Output
			meta: "Pass-through of the input signal"
		}
		propertyInputPort LabelPort {
			name: "label"
			entity: Label
			meta: "Label identifier for the probe"
		}
	]
	entities: [
		signal Input {},
		signal Output {},
		value Label { default: "Probe" },
		reaction Tap {
			streams: [
				Input >> __DebugPrint();
			]
		}
	]
	streams: [
		Input >> Output;
		Input >> Tap();
	]
	meta: "Lightweight signal probe that non-intrusively monitors a stream while passing it through"
}
