    gpio: gpioCapabilities {
        interrupts: [Gpio::InterruptNone, Gpio::InterruptRising, Gpio::InterruptFalling, Gpio::InterruptBothEdges]
    }
    resources: [
        CortexM7HardwareFpuSp,
        STM32F7ArtAccelerator,
        STM32F7DspExtensions
    ]
    upload: {
        openocd: {
            target: "target/stm32f7x.cfg"
        }
        probeRs: {
            chip: "STM32F746NGHx"
        }
    }
    meta: "STM32F746NG ARM Cortex-M7 @ 216 MHz, 1 MB flash, 320 KB SRAM, single-precision FPU"
}
