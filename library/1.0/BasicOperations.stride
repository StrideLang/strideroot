# BasicOperations.stride
# Array reduction and aggregation operations for Stride

loop Sum {
    ports: [
        mainInputPort InputPort {
            block: Input
            meta: "Array of signals to be summed"
        },
        mainOutputPort OutputPort {
            block: Output
            meta: "The sum of all signals in the array"
        }
    ]
    blocks: [
        signal Input[InputPort.size] {
            rate: OutputPort.rate
            type: OutputPort.type
            domain: OutputPort.domain
        },
        signal Output {
            default: 0.0
            rate: OutputPort.rate
            type: OutputPort.type
            domain: OutputPort.domain
            reset: Reset
        },
        signal Index {
            default: 0
            rate: none
            type: _IntType
            domain: OutputPort.domain
            reset: Reset
        },
        switch Done {
            domain: OutputPort.domain
        },
        trigger Reset {}
    ]
    onExecution: Reset
    terminateWhen: Done
    streams: [
        Input[Index] + Output >> Output;
        Index + 1 >> Index;
        [Index, InputPort.size] >> Equal() >> Done;
    ]
    meta: "Adds all signals in the input array: Input >> Sum() >> Output."
}

module Average {
    ports: [
        mainInputPort InputPort {
            block: Input
            meta: "Array of signals to be averaged"
        },
        mainOutputPort OutputPort {
            block: Output
            meta: "Arithmetic mean of all signals in the array"
        }
    ]
    blocks: [
        signal Input[InputPort.size] {
            rate: OutputPort.rate
            type: OutputPort.type
            domain: OutputPort.domain
        },
        signal Output {
            rate: OutputPort.rate
            type: OutputPort.type
            domain: OutputPort.domain
        },
        signal SumVal {
            rate: OutputPort.rate
            type: OutputPort.type
            domain: OutputPort.domain
        }
    ]
    streams: [
        Input >> Sum() >> SumVal;
        SumVal / InputPort.size >> Output;
    ]
    meta: "Computes the arithmetic mean of all signals in the input array: Input >> Average() >> Output."
}

module Clip {
    ports: [
        mainInputPort InputPort {
            block: Input
            meta: "Input signal to constrain"
        },
        mainOutputPort OutputPort {
            block: Output
            meta: "Clipped output signal"
        },
        propertyInputPort MinimumPort {
            name: "minimum"
            block: MinVal
            meta: "Lower bound"
        },
        propertyInputPort MaximumPort {
            name: "maximum"
            block: MaxVal
            meta: "Upper bound"
        }
    ]
    blocks: [
        signal Input  {
            rate: OutputPort.rate
            type: OutputPort.type 
            domain: OutputPort.domain  
        }
        signal Output {
            rate: OutputPort.rate
            type: OutputPort.type 
            domain: OutputPort.domain
        }
        signal MinVal {
            rate: OutputPort.rate
            type: OutputPort.type 
            domain: OutputPort.domain
            default: 0.0
        }
        signal MaxVal {
            rate: OutputPort.rate
            type: OutputPort.type 
            domain: OutputPort.domain
            default: 1.0
        }
    ]
    streams: [
        Input >> Clamp(min: MinVal max: MaxVal) >> Output;
    ]
    meta: "Limits signal within minimum and maximum values: Input >> Clip(minimum: 0.0 maximum: 1.0) >> Output."
}
