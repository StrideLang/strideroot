#
# BlinkRigMega: the same project wired to an Arduino Mega 2560.
#
# The signals are the same as BlinkRig.stride's, but they sit on other
# pins: the button on D22 and the relay on D9. The program never names a
# pin, so it doesn't change when they move:
#
#   D22 -- push button -- GND      PA0, internal pull-up
#   LED -- the on-board LED        D13, PB7
#   D9  -- relay module input      PH6, an extended I/O port: its writes are
#                                  lds/sts rather than sbi/cbi
#
# To build PortableBlink for the Mega, change the top of PortableBlink.stride
# to:
#
#   use AVR version 1.0 on BlinkRigMega
#   import BlinkRigMega as BlinkRig
#
# The rest of the program stays as it is: BlinkRig::Status now means this
# file's Status.
#

package BlinkRigMega

import Gpio
import ArduinoMega2560

hardwareBoard BlinkRigMega {
    overlays: ArduinoMega2560
}

gpioPin Button {
    pin: ArduinoMega2560::D22
    mode: Gpio::PinInput
    pull: Gpio::PullUp
    activeLow: on
}

gpioPin Status {
    pin: ArduinoMega2560::LED
    mode: Gpio::PinOutput
    initial: off
}

gpioPin Relay {
    pin: ArduinoMega2560::D9
    mode: Gpio::PinOutput
    outputType: Gpio::OutputOpenDrain
    activeLow: on
    initial: off
}
