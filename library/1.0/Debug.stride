module DebugPrint {
	ports: [
		mainInputPort ValueProperty {
			name: "value"
			entity: Value
		}
		propertyInputPort TriggerPort {
			name: "trigger"
			entity: Trigger
		}
	]
    entities: [
		signal Value { default: 0.0 },
		switch Trigger { default: on },
		reaction Print {
			streams: [
				Value >> __DebugPrint();
			]
		}
    ]
    streams: [
		Trigger >> Print();
    ]
    meta: ""
}

module Error {
	ports: [
		mainInputPort TriggerPort {
			entity: Trigger
		}
		propertyInputPort MessagePort {
			name: "message"
			entity: Message
		}
	]
	streams: [
	]
}

module Probe {
	ports: [
		mainInputPort InputPort {
			name: "input"
			entity: Input
			meta: "Signal to be probed and passed through"
		}
		mainOutputPort OutputPort {
			name: "output"
			entity: Output
			meta: "Pass-through of the input signal"
		}
		propertyInputPort LabelPort {
			name: "label"
			entity: Label
			meta: "Label identifier for the probe"
		}
	]
	entities: [
		signal Input {},
		signal Output {},
		value Label { default: "Probe" },
		reaction Tap {
			streams: [
				Input >> __DebugPrint();
			]
		}
	]
	streams: [
		Input >> Output;
		Input >> Tap();
	]
	meta: "Lightweight signal probe that non-intrusively monitors a stream while passing it through"
}

module Watch {
	ports: [
		mainInputPort InputPort {
			name: "input"
			entity: Input
			meta: "Signal to be watched and passed through"
		}
		mainOutputPort OutputPort {
			name: "output"
			entity: Output
			meta: "Pass-through of the input signal"
		}
		propertyInputPort LabelPort {
			name: "label"
			entity: Label
		}
	]
	entities: [
		signal Input {},
		signal Output {},
		value Label { default: "Watch" },
		reaction Tap {
			streams: [
				Input >> __DebugPrint();
			]
		}
	]
	streams: [
		Input >> Output;
		Input >> Tap();
	]
	meta: "Signal watch module for non-intrusive runtime observation"
}
