# Data types for the Pico LLVM framework.
# Int, UInt, and Size are 32-bit; Real is Float32.

frameworkDataType Int8 {
	frameworkName: "int8_t"
	includes: ["<stdint.h>"]
	kind: "integer"
	bits: 8
}

frameworkDataType Int16 {
	frameworkName: "int16_t"
	includes: ["<stdint.h>"]
	kind: "integer"
	bits: 16
}

frameworkDataType Int32 {
	frameworkName: "int32_t"
	includes: ["<stdint.h>"]
	kind: "integer"
	bits: 32
}

frameworkDataType Int64 {
	frameworkName: "int64_t"
	includes: ["<stdint.h>"]
	kind: "integer"
	bits: 64
}

frameworkDataType UInt8 {
	frameworkName: "uint8_t"
	includes: ["<stdint.h>"]
	kind: "integer"
	bits: 8
}

frameworkDataType UInt16 {
	frameworkName: "uint16_t"
	includes: ["<stdint.h>"]
	kind: "integer"
	bits: 16
}

frameworkDataType UInt32 {
	frameworkName: "uint32_t"
	includes: ["<stdint.h>"]
	kind: "integer"
	bits: 32
}

frameworkDataType UInt64 {
	frameworkName: "uint64_t"
	includes: ["<stdint.h>"]
	kind: "integer"
	bits: 64
}

frameworkDataType Float32 {
	frameworkName: "float"
	includes: []
	kind: "float"
	bits: 32
}

frameworkDataType Float64 {
	frameworkName: "double"
	includes: []
	kind: "float"
	bits: 64
}

frameworkDataType Switch {
	frameworkName: "bool"
	includes: ["<stdbool.h>"]
	kind: "switch"
}

frameworkDataType String {
	frameworkName: "StrideStringView"
	includes: []
	kind: "string"
}

# Preferred sizes for Pico (32-bit ARM Cortex-M)

alias Int {
	entity: Int32
}

alias UInt {
	entity: UInt32
}

alias Real {
	entity: Float32
}

alias Size {
	entity: UInt32
}

### ----------------------
# Type classes

typeClass _NumericTypes {
	types: [Real, Int, UInt, Size, Float32, Float64, Int8, Int16, Int32, Int64, UInt8, UInt16, UInt32, UInt64]
}

typeClass _IntegerTypes {
	types: [Int, UInt, Size, Int8, Int16, Int32, Int64, UInt8, UInt16, UInt32, UInt64]
}

typeClass _FloatTypes {
	types: [Real, Float32, Float64]
}

typeClass _DataTypes {
	types: [Real, Int, UInt, Size, Float32, Float64, Int8, Int16, Int32, Int64, UInt8, UInt16, UInt32, UInt64, Switch, String]
}
