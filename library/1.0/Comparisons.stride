# Comparisons.stride
# Relational comparison operations for Stride

module Greater {
    ports: [
        mainInputPort InputPort {
            block: Input
            meta: "Two-element list with values to compare: [Left, Right]"
        },
        mainOutputPort OutputPort {
            block: Output
            meta: "Switch indicating if Left > Right"
        }
    ]
    blocks: [
        signal Input[2] { domain: OutputPort.domain }
        switch Output   { domain: OutputPort.domain }
    ]
    streams: [
        [Input[0], Input[1]] >> __Greater() >> Output;
    ]
    meta: "Compares two input values: outputs on if Input[0] > Input[1], else off."
}

module GreaterOrEqual {
    ports: [
        mainInputPort InputPort {
            block: Input
            meta: "Two-element list with values to compare: [Left, Right]"
