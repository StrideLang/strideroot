
# Generic GPIO peripherals. The pin options themselves are the typeClasses of
# constants in the library's Gpio package (Gpio::_PinModes, _PinOutputTypes,
# _PinPulls, ...), which replace the string-valued genericOptions this file
# used to declare. A vendor's hwGenericMapping maps a typeClass's members, in
# order, to register field values.

import Gpio

genericPeripheral GENERIC_GPIO_PIN {
    name: "GPIO Pin"
    parameters: [Gpio::_PinModes, Gpio::_PinOutputTypes, Gpio::_PinPulls]
    meta: "General Purpose I/O Pin"
}

genericPeripheral GENERIC_GPIO {
    name: "GPIO"
    parameters: []
    meta: "General Purpose I/O"
}
