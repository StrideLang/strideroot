type _FrameworkTypeClass {
	typeName: "frameworkTypeClass"
	properties: [
		typeProperty Types {
			name: "types"
			allowedTypes: constrainedList { anyOf: [_FrameworkDataType] }
			required: on
			meta: "Members of the type class"
		}
	]
	meta: ""
}

type _FrameworkDataType {
	typeName: "frameworkDataType"
	properties: [
		typeProperty Name {
			name: "name"
			allowedTypes: _StringLiteral
			default: ""
			required: off
			meta: "Name of the data type"
		}
		typeProperty FrameworkName {
			name: "frameworkName"
			allowedTypes: _StringLiteral
			required: on
			meta: "Name of the data type on the target platform"
		}
		typeProperty Includes {
			name: "includes"
			allowedTypes: constrainedList { anyOf: [_StringLiteral] }
			default: []
			required: off
			meta: "Additional include files for the type"
		}
	]
	meta: ""
}
